.record-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 38rpx 120rpx;
  color: #332b23;
  background:
    linear-gradient(rgba(250, 247, 241, .9), rgba(238, 228, 215, .94)),
    repeating-linear-gradient(45deg, #eee5d8 0, #eee5d8 2rpx, #f5ede4 2rpx, #f5ede4 5rpx);
}

.status-space {
  height: 92rpx;
}

.page-head {
  padding: 12rpx 10rpx 30rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 12rpx;
  color: #746858;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 1.6;
}

.entry-card {
  position: relative;
  box-sizing: border-box;
  margin-bottom: 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(137, 104, 64, .3);
  border-radius: 22rpx;
  background: rgba(252, 248, 241, .86);
  box-shadow: 0 10rpx 30rpx rgba(75, 52, 28, .07);
}

.section-label {
  position: relative;
  z-index: 3;
  color: #504235;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.section-label-small {
  color: #8a7966;
  font-size: 21rpx;
  font-weight: 400;
  letter-spacing: 0;
}

.date-picker {
  display: block;
}

.date-card {
  height: 132rpx;
  padding: 20rpx 26rpx;
}

.date-row {
  display: flex;
  align-items: center;
  height: 70rpx;
}

.calendar-icon {
  position: relative;
  width: 54rpx;
  height: 50rpx;
  margin-right: 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #9d7b4c;
  border-radius: 8rpx;
  color: #775a34;
  text-align: center;
}

.calendar-icon::before {
  content: "";
  position: absolute;
  left: -2rpx;
  right: -2rpx;
  top: 10rpx;
  border-top: 2rpx solid #9d7b4c;
}

.calendar-icon text {
  display: block;
  padding-top: 14rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.calendar-rings::before,
.calendar-rings::after {
  content: "";
  position: absolute;
  top: -7rpx;
  width: 3rpx;
  height: 12rpx;
  border-radius: 3rpx;
  background: #9d7b4c;
}

.calendar-rings::before {
  left: 12rpx;
}

.calendar-rings::after {
  right: 12rpx;
}

.date-value {
  flex: 1;
  font-family: var(--font-numeral);
  font-size: 34rpx;
  font-weight: 400;
  letter-spacing: 3rpx;
}

.date-arrow {
  color: #9b866c;
  font-size: 34rpx;
}

.photo-card {
  height: 322rpx;
  padding: 24rpx 26rpx;
}

.photo-empty {
  position: absolute;
  inset: 72rpx 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9b866c;
}

.photo-plus {
  color: #8d6d43;
  font-size: 68rpx;
  font-weight: 400;
  line-height: 1;
}

.photo-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
}

.photo-preview {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.photo-card.has-photo::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(23, 18, 13, .42), transparent 42%, rgba(23, 18, 13, .22));
}

.photo-card.has-photo .section-label {
  color: #fffdf8;
  text-shadow: 0 2rpx 8rpx rgba(30, 22, 15, .45);
}

.replace-photo {
  position: absolute;
  z-index: 3;
  right: 22rpx;
  bottom: 18rpx;
  padding: 8rpx 14rpx;
  border-radius: 20rpx;
  color: #fff;
  background: rgba(39, 31, 23, .48);
  font-size: 20rpx;
}

.story-card {
  height: 252rpx;
  padding: 24rpx 26rpx 18rpx;
}

.writing-area {
  position: relative;
  height: 176rpx;
  margin-top: 4rpx;
}

.guide-lines {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  padding-top: 20rpx;
  box-sizing: border-box;
}

.guide-lines view {
  border-bottom: 1rpx dashed rgba(126, 104, 78, .36);
}

.story-input {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 176rpx;
  padding: 16rpx 0 0;
  box-sizing: border-box;
  color: #3e342a;
  background: transparent;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 43rpx;
}

.story-placeholder {
  color: #ad9c88;
}

.voice-card {
  min-height: 174rpx;
  padding: 23rpx 26rpx;
}

.voice-control {
  display: flex;
  align-items: center;
  height: 86rpx;
  margin-top: 5rpx;
}

.microphone {
  position: relative;
  width: 66rpx;
  height: 66rpx;
  flex: 0 0 66rpx;
  border-radius: 50%;
  background: #8d6b40;
  box-shadow: 0 0 0 10rpx rgba(141, 107, 64, .1);
}

.mic-head {
  position: absolute;
  left: 24rpx;
  top: 13rpx;
  width: 18rpx;
  height: 27rpx;
  box-sizing: border-box;
  border: 3rpx solid #fffaf1;
  border-radius: 10rpx;
}

.mic-stem {
  position: absolute;
  left: 20rpx;
  top: 30rpx;
  width: 26rpx;
  height: 18rpx;
  box-sizing: border-box;
  border: 3rpx solid #fffaf1;
  border-top: 0;
  border-radius: 0 0 15rpx 15rpx;
}

.mic-stem::after {
  content: "";
  position: absolute;
  left: 9rpx;
  bottom: -9rpx;
  width: 3rpx;
  height: 9rpx;
  background: #fffaf1;
}

.waveform {
  flex: 1;
  height: 58rpx;
  margin: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wave-bar {
  width: 4rpx;
  height: 12rpx;
  border-radius: 4rpx;
  background: #c2ad92;
}

.wave-bar-1,
.wave-bar-5,
.wave-bar-9,
.wave-bar-13 {
  height: 24rpx;
}

.wave-bar-2,
.wave-bar-6,
.wave-bar-10,
.wave-bar-14 {
  height: 38rpx;
}

.wave-bar-3,
.wave-bar-7,
.wave-bar-11 {
  height: 52rpx;
}

.voice-state {
  min-width: 112rpx;
  color: #8b7862;
  font-size: 21rpx;
  text-align: right;
}

.is-recording .microphone {
  background: #9c5546;
  box-shadow: 0 0 0 12rpx rgba(156, 85, 70, .12);
  animation: mic-pulse 1.2s ease-in-out infinite;
}

.is-recording .wave-bar {
  background: #9c6654;
  animation: sound-wave .82s ease-in-out infinite alternate;
}

.is-recording .wave-bar:nth-child(3n + 1) {
  animation-delay: -.2s;
}

.is-recording .wave-bar:nth-child(3n + 2) {
  animation-delay: -.45s;
}

@keyframes sound-wave {
  0% { transform: scaleY(.35); opacity: .55; }
  100% { transform: scaleY(1.15); opacity: 1; }
}

@keyframes mic-pulse {
  50% { transform: scale(.94); }
}

.collect-button {
  height: 94rpx;
  margin-top: 30rpx;
  border-radius: 14rpx;
  color: #fffaf1;
  background: linear-gradient(100deg, #76562f, #a47b43);
  box-shadow: 0 12rpx 28rpx rgba(104, 72, 35, .2);
  font-size: 31rpx;
  font-weight: 500;
  letter-spacing: 12rpx;
  line-height: 94rpx;
}

.collect-button::after {
  border: 0;
}

.save-note {
  padding: 18rpx 0 4rpx;
  color: #907e68;
  font-size: 21rpx;
  text-align: center;
}

.bottom-space {
  height: 28rpx;
}
