.record-page {
  min-height: 100vh;
  padding: calc(54rpx + env(safe-area-inset-top)) 48rpx 120rpx;
  box-sizing: border-box;
  color: #302920;
  background:
    repeating-linear-gradient(45deg,rgba(127,99,65,.018) 0,rgba(127,99,65,.018) 1rpx,transparent 1rpx,transparent 7rpx),
    linear-gradient(145deg,#faf6ef,#eee4d7);
}
.record-page.editing-record-page { padding-top: 0; }
.record-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 38rpx;
}
.page-title {
  font-size: 56rpx;
  letter-spacing: 8rpx;
}
.edit-nav { position: relative; z-index: 15; margin: 0 -48rpx 38rpx; box-sizing: border-box; background: rgba(216,196,168,.96); border-bottom: 1rpx solid rgba(91,66,35,.2); }
.edit-nav-row { padding: 0 34rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; }
.edit-nav-title { color: #302920; font-size: 38rpx; font-weight: 400; letter-spacing: 5rpx; }
.edit-back { width: 80rpx; color: #302920; font-family: serif; font-size: 58rpx; font-weight: 400; line-height: 1; }
.edit-nav-spacer { width: 80rpx; }
.museum-frame {
  position: relative;
  width: 100%;
  height: 650rpx;
  filter: drop-shadow(0 17rpx 22rpx rgba(77,53,28,.2));
  transform-origin: center center;
  transition: filter .25s ease;
}
.admission-target.is-admitting { position: relative; z-index: 701; pointer-events: none; animation: exhibit-admit 1.25s cubic-bezier(.2,.72,.22,1) both; }
.admission-target.is-admitting.is-leaving { animation: exhibit-exit-left .32s cubic-bezier(.55,.08,.72,.42) both; }
.admission-room-wash { position: fixed; inset: 0; z-index: 700; pointer-events: auto; background: radial-gradient(circle at 50% 34%,rgba(255,245,210,.08),rgba(50,38,27,.38) 72%); animation: room-dim 1.25s ease both; }
.admission-glass { position: absolute; inset: 20rpx; z-index: 8; overflow: hidden; border-radius: 3rpx; background: linear-gradient(145deg,rgba(255,255,255,.02),rgba(230,213,180,.12)); box-shadow: inset 0 0 0 2rpx rgba(255,248,225,.55),inset 0 0 32rpx rgba(255,238,194,.18); animation: glass-close .55s ease-out both; }
.admission-case-edge { position: absolute; inset: 0; border: 4rpx double rgba(228,204,158,.72); box-sizing: border-box; box-shadow: inset 0 0 22rpx rgba(78,55,31,.18); }
.admission-light { position: absolute; top: -35%; left: -55%; width: 38%; height: 170%; z-index: 2; transform: rotate(18deg); background: linear-gradient(90deg,transparent,rgba(255,250,225,.78),transparent); filter: blur(4rpx); animation: admission-light-sweep .72s .22s ease-in-out both; }
.admission-stamp { position: absolute; right: 28rpx; bottom: 28rpx; z-index: 4; padding: 13rpx 18rpx 11rpx; border: 4rpx double rgba(132,87,38,.88); color: #79542d; background: rgba(249,237,212,.87); font-size: 21rpx; font-weight: 500; letter-spacing: 2rpx; opacity: 0; transform: rotate(-7deg) scale(1.5); box-shadow: 0 5rpx 13rpx rgba(57,38,20,.17); }
.admission-stamp.is-visible { animation: admission-stamp-in .34s cubic-bezier(.2,1.45,.45,1) forwards; }
.admission-glass.compact { inset: -10rpx; border-radius: 16rpx; }
.admission-glass.compact .admission-stamp { right: 13rpx; bottom: 10rpx; padding: 7rpx 11rpx 6rpx; font-size: 17rpx; letter-spacing: 1rpx; }
@keyframes exhibit-admit { 0% { transform: translateY(0) scale(1); filter: drop-shadow(0 17rpx 22rpx rgba(77,53,28,.2)) brightness(1); } 48% { transform: translateY(-5rpx) scale(.91); filter: drop-shadow(0 25rpx 30rpx rgba(48,32,18,.26)) brightness(1.08); } 100% { transform: translateY(-10rpx) scale(.82); filter: drop-shadow(0 30rpx 38rpx rgba(38,25,14,.32)) brightness(.94); } }
@keyframes room-dim { 0% { opacity: 0; } 35%,75% { opacity: 1; } 100% { opacity: .78; } }
@keyframes glass-close { 0% { opacity: 0; transform: scaleX(1.08); } 100% { opacity: 1; transform: scaleX(1); } }
@keyframes admission-light-sweep { 0% { left: -55%; opacity: 0; } 12% { opacity: 1; } 88% { opacity: .9; } 100% { left: 125%; opacity: 0; } }
@keyframes admission-stamp-in { 0% { opacity: 0; transform: rotate(-7deg) scale(1.5); } 70% { opacity: 1; transform: rotate(-7deg) scale(.94); } 100% { opacity: 1; transform: rotate(-7deg) scale(1); } }
@keyframes exhibit-exit-left { 0% { opacity: 1; transform: translateX(0) translateY(-10rpx) scale(.82); } 100% { opacity: 0; transform: translateX(-64vw) translateY(-10rpx) scale(.78); } }
.frame-outer {
  position: absolute;
  inset: 0;
  padding: 25rpx;
  box-sizing: border-box;
  border: 3rpx solid #c5ad88;
  background:
    repeating-linear-gradient(45deg,rgba(126,94,54,.08) 0,rgba(126,94,54,.08) 2rpx,transparent 2rpx,transparent 9rpx),
    linear-gradient(135deg,#f2e8d8,#c5aa82 25%,#f7efe2 52%,#b89b70 78%,#eee1cd);
  box-shadow: inset 0 0 0 8rpx rgba(255,251,241,.65), inset 0 0 0 13rpx rgba(133,98,57,.25);
}
.frame-carving {
  position: absolute;
  inset: 10rpx;
  border: 3rpx double rgba(126,91,51,.45);
  pointer-events: none;
}
.frame-middle {
  width: 100%;
  height: 100%;
  padding: 28rpx;
  box-sizing: border-box;
  border: 8rpx ridge #b5996e;
  background: linear-gradient(135deg,#d2bb96,#f4e9d8 48%,#aa8b60);
}
.frame-inner {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  box-sizing: border-box;
  border: 3rpx solid rgba(109,78,44,.48);
  background:
    repeating-linear-gradient(45deg,rgba(129,99,62,.018) 0,rgba(129,99,62,.018) 1rpx,transparent 1rpx,transparent 8rpx),
    #f4ede1;
  box-shadow: inset 0 0 28rpx rgba(103,72,38,.1);
}
.photo-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.camera-icon {
  position: relative;
  width: 88rpx;
  height: 76rpx;
  margin-bottom: 34rpx;
}
.camera-top {
  position: absolute;
  top: 0;
  left: 27rpx;
  width: 34rpx;
  height: 18rpx;
  box-sizing: border-box;
  border: 5rpx solid #776347;
  border-bottom: 0;
  border-radius: 8rpx 8rpx 0 0;
}
.camera-body {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 88rpx;
  height: 63rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 5rpx solid #776347;
  border-radius: 12rpx;
}
.camera-lens {
  width: 35rpx;
  height: 35rpx;
  line-height: 31rpx;
  text-align: center;
  border: 4rpx solid #776347;
  border-radius: 50%;
  font-size: 29rpx;
}
.upload-title {
  font-size: 35rpx;
  letter-spacing: 3rpx;
}
.upload-copy {
  margin-top: 20rpx;
  color: #766858;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}
.photo-preview {
  width: 100%;
  height: 100%;
  display: block;
}
.replace-photo {
  position: absolute;
  right: 20rpx;
  bottom: 18rpx;
  padding: 9rpx 15rpx;
  color: #fffaf1;
  background: rgba(47,36,24,.55);
  border-radius: 20rpx;
  font-size: 20rpx;
}
.composer {
  min-height: 88rpx;
  margin-top: 42rpx;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 17rpx;
  border: 0;
  background: transparent;
}
.composer.has-decision {
  margin-top: 18rpx;
}
.voice-decision {
  margin-top: 31rpx;
  display: flex;
  justify-content: center;
  gap: 18rpx;
}
.voice-decision-bubble {
  position: relative;
  width: calc(50% - 9rpx);
  min-height: 92rpx;
  padding: 17rpx 18rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(137,103,61,.28);
  border-radius: 17rpx;
  text-align: center;
  color: #4e4032;
  background:
    repeating-linear-gradient(45deg,rgba(126,94,54,.018) 0,rgba(126,94,54,.018) 1rpx,transparent 1rpx,transparent 7rpx),
    rgba(250,245,237,.96);
  box-shadow: 0 10rpx 22rpx rgba(67,47,26,.13), inset 0 1rpx 0 rgba(255,255,255,.8);
}
.voice-decision-bubble::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  width: 18rpx;
  height: 18rpx;
  border-right: 1rpx solid rgba(137,103,61,.25);
  border-bottom: 1rpx solid rgba(137,103,61,.25);
  background: #f8f2e9;
  transform: rotate(45deg);
}
.keep-voice::after { right: 35rpx; }
.convert-text::after { left: 35rpx; }
.voice-decision-title {
  font-size: 27rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}
.voice-decision-copy {
  margin-top: 7rpx;
  color: #9b856d;
  font-size: 19rpx;
  letter-spacing: 1rpx;
}
.voice-decision-bubble.is-unavailable {
  color: #897b6d;
  opacity: .66;
}
.mode-toggle {
  width: 82rpx;
  height: 82rpx;
  flex: 0 0 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #4a453e;
  border-radius: 50%;
  background: #f6f3ee;
  box-shadow: 0 5rpx 10rpx rgba(61,49,35,.13), inset 0 1rpx 3rpx rgba(255,255,255,.85);
}
.speech-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}
.sound-dot {
  position: absolute;
  left: 5rpx;
  top: 21rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #2f2f2d;
}
.sound-wave {
  position: absolute;
  top: 50%;
  box-sizing: border-box;
  border-right: 4rpx solid #2f2f2d;
  border-radius: 50%;
  transform: translateY(-50%);
}
.sound-wave-one {
  left: 9rpx;
  width: 19rpx;
  height: 25rpx;
}
.sound-wave-two {
  left: 11rpx;
  width: 31rpx;
  height: 42rpx;
}
.keyboard-icon {
  width: 46rpx;
  height: 38rpx;
  padding: 6rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 3rpx;
  border: 3rpx solid #343330;
  border-radius: 5rpx;
}
.keyboard-key {
  background: #343330;
  border-radius: 1rpx;
}
.story-input {
  flex: 1;
  width: auto;
  min-height: 82rpx;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  color: #40362b;
  border: 3rpx double rgba(143,111,72,.38);
  border-radius: 18rpx;
  background: rgba(249,243,234,.82);
  box-shadow: inset 0 0 16rpx rgba(109,78,43,.05);
  font-size: 29rpx;
  line-height: 42rpx;
  text-align: left;
  overflow-y: auto;
}
.story-placeholder {
  color: #9c8b76;
}
.hold-to-talk {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  text-align: center;
  border: 1rpx solid rgba(118,94,63,.3);
  border-radius: 12rpx;
  color: #3e372f;
  background: linear-gradient(#faf7f1,#e8dfd2);
  font-size: 29rpx;
  letter-spacing: 3rpx;
  user-select: none;
}
.hold-to-talk.is-recording {
  color: #fff9ef;
  background: linear-gradient(100deg,#8f6d47,#a8875e);
  box-shadow: 0 0 0 7rpx rgba(147,111,69,.1), inset 0 3rpx 9rpx rgba(73,51,27,.15);
}
.hall-destination {
  margin-top: 24rpx;
  text-align: center;
}
.destination-label {
  color: #6f5b43;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}
.destination-label text {
  display: inline-block;
  margin-left: 4rpx;
  color: #a37b47;
  font-size: 30rpx;
  transform: translateY(2rpx);
}
.hall-choice {
  position: relative;
  width: 220rpx;
  height: 86rpx;
  margin: 14rpx auto 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx double rgba(158,119,73,.55);
  border-radius: 10rpx;
  color: #4f3d2b;
  background:
    repeating-linear-gradient(45deg,rgba(128,91,49,.022) 0,rgba(128,91,49,.022) 2rpx,transparent 2rpx,transparent 8rpx),
    rgba(249,243,233,.86);
  box-shadow: 0 9rpx 22rpx rgba(72,50,27,.12), inset 0 0 0 5rpx rgba(255,255,255,.32);
}
.hall-choice-name {
  max-width: 158rpx;
  overflow: hidden;
  font-size: 29rpx;
  font-weight: 500;
  letter-spacing: 5rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.hall-choice-arrow {
  position: absolute;
  right: 15rpx;
  top: 23rpx;
  color: #997548;
  font-size: 27rpx;
}
.submit-button {
  width: 470rpx;
  height: 104rpx;
  margin: 23rpx auto 0;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border: 4rpx double rgba(233,219,193,.75);
  border-radius: 12rpx;
  color: #fff8ed;
  background:
    repeating-linear-gradient(45deg,rgba(255,255,255,.025) 0,rgba(255,255,255,.025) 2rpx,transparent 2rpx,transparent 8rpx),
    linear-gradient(100deg,#725637,#95744d);
  box-shadow: 0 13rpx 26rpx rgba(74,51,27,.2);
  font-size: 42rpx;
  letter-spacing: 14rpx;
}
.submit-button::after { border: 0; }
.save-note {
  margin-top: 11rpx;
  text-align: center;
  color: #93816b;
  font-size: 20rpx;
}
.bottom-space { height: 30rpx; }

.hall-selector-mask {
  position: fixed;
  inset: 0;
  z-index: 500;
  display: flex;
  align-items: flex-end;
  background: rgba(45,37,29,.48);
  backdrop-filter: blur(3rpx);
}
.hall-selector-mask.tutorial-selector { z-index: 160; }
.hall-selector-sheet {
  width: 100%;
  max-height: 68vh;
  padding: 16rpx 26rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 30rpx 30rpx 0 0;
  background:
    repeating-linear-gradient(45deg,rgba(127,99,65,.016) 0,rgba(127,99,65,.016) 1rpx,transparent 1rpx,transparent 7rpx),
    #f5ede1;
  box-shadow: 0 -20rpx 50rpx rgba(40,29,19,.2);
}
.selector-handle {
  width: 68rpx;
  height: 7rpx;
  margin: 0 auto 25rpx;
  border-radius: 6rpx;
  background: rgba(119,91,61,.28);
}
.selector-title {
  text-align: center;
  color: #3f3327;
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
}
.selector-subtitle {
  margin-top: 10rpx;
  text-align: center;
  color: #9a856d;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}
.hall-option-list {
  max-height: 380rpx;
  margin-top: 28rpx;
}
.hall-option {
  min-height: 92rpx;
  margin-bottom: 13rpx;
  padding: 0 23rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(145,111,70,.23);
  border-radius: 12rpx;
  color: #4f4133;
  background: rgba(255,251,244,.68);
}
.hall-option.selected {
  border-color: rgba(157,113,58,.62);
  background: rgba(240,225,204,.78);
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,.42);
}
.hall-option-mark {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  line-height: 48rpx;
  text-align: center;
  border: 1rpx solid rgba(157,116,65,.5);
  color: #927047;
  font-size: 22rpx;
}
.hall-option-name {
  flex: 1;
  overflow: hidden;
  font-size: 27rpx;
  letter-spacing: 2rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.hall-option-check,
.hall-option-chevron {
  width: 42rpx;
  text-align: right;
  color: #9a713e;
  font-size: 30rpx;
}
.hall-option-check {
  font-size: 24rpx;
}
.create-hall-option {
  min-height: 94rpx;
  margin-top: 15rpx;
  padding: 0 23rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  border: 1rpx dashed rgba(139,101,57,.45);
  border-radius: 12rpx;
  color: #584735;
  background: rgba(222,205,181,.34);
}
.create-hall-plus {
  width: 48rpx;
  margin-right: 20rpx;
  color: #8b6539;
  font-family: var(--font-numeral);
  font-size: 45rpx;
  font-weight: 300;
  line-height: 1;
  text-align: center;
}
.create-hall-copy { flex: 1; font-size: 27rpx; letter-spacing: 2rpx; }
.selector-cancel {
  width: 330rpx;
  height: 75rpx;
  margin: 20rpx auto 0;
  padding: 0;
  line-height: 75rpx;
  border: 1rpx solid rgba(139,108,71,.26);
  border-radius: 10rpx;
  color: #675643;
  background: rgba(255,251,245,.7);
  font-family: var(--font-display);
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
}
.selector-cancel::after { border: 0; }

.tutorial-photo-mask { position: fixed; inset: 0; z-index: 870; display: flex; align-items: center; justify-content: center; padding: 48rpx; box-sizing: border-box; background: rgba(39,30,22,.62); -webkit-backdrop-filter: blur(6rpx); backdrop-filter: blur(6rpx); }
.tutorial-photo-card { width: 100%; padding: 42rpx 40rpx 28rpx; box-sizing: border-box; border: 2rpx solid rgba(174,133,79,.5); border-radius: 25rpx; text-align: center; background: repeating-linear-gradient(45deg,rgba(125,95,59,.02) 0,rgba(125,95,59,.02) 1rpx,transparent 1rpx,transparent 8rpx),linear-gradient(145deg,#fbf5e9,#eadbc5); box-shadow: 0 30rpx 72rpx rgba(34,23,13,.36),inset 0 0 0 6rpx rgba(255,251,241,.5); }
.tutorial-photo-kicker { color: #a08461; font-family: var(--font-numeral); font-size: 17rpx; letter-spacing: 4rpx; }
.tutorial-photo-title { margin-top: 10rpx; color: #382e25; font-size: 40rpx; font-weight: 500; letter-spacing: 4rpx; }
.tutorial-photo-copy { margin: 17rpx 5rpx 25rpx; color: #796650; font-size: 22rpx; line-height: 1.65; }
.tutorial-photo-frame { position: relative; height: 430rpx; padding: 13rpx 13rpx 58rpx; box-sizing: border-box; border: 3rpx double rgba(130,91,45,.65); background: linear-gradient(135deg,#d5b879,#8e6335 24%,#d4b276 52%,#936a3a 76%,#e1c58b); box-shadow: inset 0 4rpx 5rpx rgba(255,241,200,.55),0 12rpx 25rpx rgba(57,39,22,.2); }
.tutorial-photo-frame image { width: 100%; height: 100%; display: block; border: 8rpx solid #eee4d4; box-sizing: border-box; }
.tutorial-photo-label { position: absolute; left: 0; right: 0; bottom: 17rpx; color: #33281e; font-size: 21rpx; letter-spacing: 2rpx; }
.tutorial-photo-check { position: absolute; right: -15rpx; top: -15rpx; width: 54rpx; height: 54rpx; border: 4rpx solid #f7eedf; border-radius: 50%; color: #fffaf0; background: #8d6738; font-size: 27rpx; line-height: 50rpx; }
.tutorial-photo-confirm { height: 82rpx; margin: 27rpx 0 0; padding: 0; border-radius: 11rpx; color: #fffaf0; background: linear-gradient(135deg,#ad8651,#805a2d); font-family: var(--font-display); font-size: 27rpx; line-height: 82rpx; letter-spacing: 3rpx; }
.tutorial-photo-back { height: 63rpx; margin: 9rpx 0 0; padding: 0; color: #806d58; background: transparent; font-family: var(--font-display); font-size: 21rpx; line-height: 63rpx; }
.tutorial-photo-confirm::after,.tutorial-photo-back::after { border: 0; }

.audio-title-mask { position: fixed; inset: 0; z-index: 880; display: flex; align-items: center; justify-content: center; padding: 52rpx; box-sizing: border-box; background: rgba(39,30,22,.62); -webkit-backdrop-filter: blur(7rpx); backdrop-filter: blur(7rpx); }
.audio-title-card { width: 100%; padding: 43rpx 39rpx 25rpx; box-sizing: border-box; border: 2rpx solid rgba(174,133,79,.48); border-radius: 25rpx; text-align: center; background: repeating-linear-gradient(45deg,rgba(125,95,59,.02) 0,rgba(125,95,59,.02) 1rpx,transparent 1rpx,transparent 8rpx),linear-gradient(145deg,#fbf5e9,#eadbc5); box-shadow: 0 30rpx 72rpx rgba(34,23,13,.36),inset 0 0 0 6rpx rgba(255,251,241,.5); }
.audio-title-kicker { color: #a08461; font-family: var(--font-numeral); font-size: 17rpx; letter-spacing: 4rpx; }
.audio-title-heading { margin-top: 11rpx; color: #382e25; font-size: 39rpx; font-weight: 500; letter-spacing: 4rpx; }
.audio-title-copy { margin: 17rpx 0 27rpx; color: #796650; font-size: 22rpx; line-height: 1.65; }
.audio-title-field { height: 86rpx; padding: 0 22rpx; display: flex; align-items: center; box-sizing: border-box; border: 1rpx solid rgba(139,101,57,.36); border-radius: 11rpx; background: rgba(255,252,246,.72); box-shadow: inset 0 2rpx 8rpx rgba(93,64,31,.06); }
.audio-title-note { width: 44rpx; margin-right: 13rpx; color: #936b3b; font-family: serif; font-size: 31rpx; }
.audio-title-field input { flex: 1; height: 84rpx; color: #3f3328; font-family: var(--font-display); font-size: 27rpx; text-align: left; }
.audio-title-confirm { height: 82rpx; margin: 27rpx 0 0; padding: 0; border-radius: 11rpx; color: #fffaf0; background: linear-gradient(135deg,#ad8651,#805a2d); font-family: var(--font-display); font-size: 26rpx; line-height: 82rpx; letter-spacing: 2rpx; }
.audio-title-skip { height: 62rpx; margin: 8rpx 0 0; padding: 0; color: #806d58; background: transparent; font-family: var(--font-display); font-size: 21rpx; line-height: 62rpx; }
.audio-title-confirm::after,.audio-title-skip::after { border: 0; }

.hall-creator-mask { position: fixed; inset: 0; z-index: 510; display: flex; align-items: flex-end; background: rgba(39,31,24,.52); }
.hall-creator-sheet { width: 100%; max-height: 90vh; padding: 18rpx 42rpx calc(34rpx + env(safe-area-inset-bottom)); box-sizing: border-box; overflow-y: auto; border-radius: 34rpx 34rpx 0 0; background: linear-gradient(155deg,#faf6ef,#eee3d5); box-shadow: 0 -18rpx 45rpx rgba(37,27,18,.2); }
.creator-heading { display: flex; justify-content: space-between; align-items: flex-start; }
.creator-kicker { margin-bottom: 10rpx; color: #a08461; font-family: var(--font-numeral); font-size: 18rpx; letter-spacing: 3rpx; }
.creator-title { font-size: 42rpx; font-weight: 500; letter-spacing: 4rpx; }
.creator-close { width: 60rpx; height: 60rpx; line-height: 54rpx; text-align: center; border: 1rpx solid rgba(122,94,61,.25); border-radius: 50%; color: #715d46; font-size: 40rpx; }
.creator-note { margin: 20rpx 0 34rpx; color: #8a7762; font-size: 24rpx; line-height: 1.7; }
.creator-field-label { margin: 24rpx 0 12rpx; color: #493b2d; font-size: 25rpx; font-weight: 500; }
.creator-field-label text { margin-left: 10rpx; color: #a38e76; font-size: 19rpx; font-weight: 400; }
.creator-input { height: 80rpx; padding: 0 23rpx; border: 1rpx solid rgba(137,104,64,.3); border-radius: 10rpx; background: rgba(255,252,246,.68); color: #342a20; font-family: var(--font-display); font-size: 27rpx; }
.creator-cover-label { margin-top: 30rpx; }
.creator-cover-list { width: calc(100% + 42rpx); }
.creator-cover-row { display: flex; gap: 16rpx; padding: 2rpx 42rpx 6rpx 2rpx; }
.creator-cover-choice { position: relative; flex: none; width: 126rpx; height: 126rpx; box-sizing: border-box; overflow: hidden; border: 3rpx solid transparent; border-radius: 12rpx; background: #d5c4ac; }
.creator-cover-choice.selected { border-color: #99703c; box-shadow: 0 0 0 3rpx rgba(153,112,60,.14); }
.creator-cover-choice image { width: 100%; height: 100%; display: block; }
.default-cover-choice { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #6e5940; }
.creator-small-arch { width: 45rpx; height: 53rpx; border: 2rpx solid #8c6c45; border-bottom: 0; border-radius: 28rpx 28rpx 0 0; }
.default-cover-choice text { margin-top: 8rpx; font-size: 19rpx; }
.creator-actions { margin-top: 38rpx; display: flex; gap: 18rpx; }
.creator-actions button { height: 82rpx; margin: 0; padding: 0; flex: 1; line-height: 82rpx; border-radius: 10rpx; font-family: var(--font-display); font-size: 27rpx; font-weight: 500; }
.creator-actions button::after { border: 0; }
.creator-cancel { border: 1rpx solid rgba(128,96,57,.3); background: rgba(255,250,242,.58); color: #705d47; }
.creator-submit { background: linear-gradient(135deg,#ad8651,#8c642f); color: #fffaf0; box-shadow: 0 9rpx 18rpx rgba(101,70,31,.18); }
