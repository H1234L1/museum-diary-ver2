<view class="record-page {{isEditing ? 'editing-record-page' : ''}}">
  <view wx:if="{{isEditing}}" class="edit-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="edit-nav-row" style="height: {{navigationBarHeight}}px;">
      <view class="edit-back" bindtap="exitEdit">‹</view>
      <view class="edit-nav-title">编辑</view>
      <view class="edit-nav-spacer"></view>
    </view>
  </view>
  <view wx:else class="record-header">
    <view class="page-title">记录</view>
  </view>

  <view class="museum-frame {{admissionAnimating && admissionTarget === 'photo' ? 'admission-target is-admitting' : ''}} {{admissionLeaving && admissionTarget === 'photo' ? 'is-leaving' : ''}}" bindtap="chooseImage">
    <view class="frame-outer">
      <view class="frame-carving"></view>
      <view class="frame-middle">
        <view class="frame-inner">
          <image wx:if="{{image}}" class="photo-preview" src="{{image}}" mode="aspectFill"></image>
          <view wx:else class="photo-empty">
            <view class="camera-icon">
              <view class="camera-top"></view>
              <view class="camera-body"><view class="camera-lens">＋</view></view>
            </view>
            <view class="upload-title">添加图片</view>
            <view class="upload-copy">为你的博物馆，收藏一件新展品</view>
          </view>
          <view wx:if="{{image}}" class="replace-photo">轻触更换图片</view>
        </view>
      </view>
    </view>
    <view wx:if="{{admissionAnimating && admissionTarget === 'photo'}}" class="admission-glass" catchtap="stopPropagation">
      <view class="admission-light"></view>
      <view class="admission-case-edge"></view>
      <view class="admission-stamp {{admissionStampVisible ? 'is-visible' : ''}}">{{admissionLabel}}</view>
    </view>
  </view>

  <view class="composer {{voiceMode ? 'voice-mode' : ''}} {{admissionAnimating && admissionTarget !== 'photo' ? 'admission-target is-admitting admission-' + admissionTarget : ''}} {{admissionLeaving && admissionTarget !== 'photo' ? 'is-leaving' : ''}}">
    <view class="mode-toggle" bindtap="toggleVoiceMode">
      <view wx:if="{{!voiceMode}}" class="speech-icon">
        <view class="sound-dot"></view>
        <view class="sound-wave sound-wave-one"></view>
        <view class="sound-wave sound-wave-two"></view>
      </view>
      <view wx:else class="keyboard-icon">
        <view wx:for="{{keyboardKeys}}" wx:key="*this" class="keyboard-key"></view>
      </view>
    </view>

    <textarea
      wx:if="{{!voiceMode}}"
      class="story-input"
      style="height: {{textBoxHeight}}px;"
      value="{{story}}"
      maxlength="-1"
      auto-height="{{false}}"
      show-confirm-bar="{{false}}"
      disable-default-padding="{{true}}"
      placeholder="写点什么"
      placeholder-class="story-placeholder"
      focus="{{storyFocused}}"
      bindinput="setStory"
      bindlinechange="resizeStoryInput"
      bindblur="handleStoryBlur"
    ></textarea>

    <view
      wx:else
      class="hold-to-talk {{recording ? 'is-recording' : ''}}"
      bindtap="handleVoiceTap"
    >{{voiceButtonText}}</view>
    <view wx:if="{{admissionAnimating && admissionTarget !== 'photo'}}" class="admission-glass compact" catchtap="stopPropagation">
      <view class="admission-light"></view>
      <view class="admission-case-edge"></view>
      <view class="admission-stamp {{admissionStampVisible ? 'is-visible' : ''}}">{{admissionLabel}}</view>
    </view>
  </view>

  <view class="hall-destination">
    <view class="destination-label">内容收藏至 <text>›</text></view>
    <view class="hall-choice" bindtap="openHallSelector">
      <view class="hall-choice-name">{{hall}}</view>
      <view class="hall-choice-arrow">⌄</view>
    </view>
    <view class="save-note">{{isEditing ? '修改将保存至原展品' : '内容默认存入主馆'}}</view>
  </view>

  <button class="submit-button" bindtap="save">{{isEditing ? '保存修改' : '入藏'}}</button>

  <view class="bottom-space"></view>
  <museum-guide id="museumGuide" bind:action="handleTutorialAction"></museum-guide>
  <museum-nav active="record"></museum-nav>
  <view wx:if="{{toast}}" class="toast">{{toast}}</view>

  <view wx:if="{{tutorialPhotoPickerVisible}}" class="tutorial-photo-mask">
    <view class="tutorial-photo-card">
      <view class="tutorial-photo-kicker">FIRST EXHIBIT</view>
      <view class="tutorial-photo-title">选择示例照片</view>
      <view class="tutorial-photo-copy">第一次入藏，先从博物馆为你准备的照片开始。</view>
      <view class="tutorial-photo-frame">
        <image src="/assets/art/home-hero.jpg" mode="aspectFill"></image>
        <view class="tutorial-photo-label">默认照片 · 博物馆展厅</view>
        <view class="tutorial-photo-check">✓</view>
      </view>
      <button class="tutorial-photo-confirm" bindtap="confirmTutorialPhoto">选择这张照片</button>
      <button class="tutorial-photo-back" bindtap="closeTutorialPhotoPicker">返回上一步</button>
    </view>
  </view>

  <view wx:if="{{audioTitleDialogVisible}}" class="audio-title-mask" bindtap="cancelAudioTitle">
    <view class="audio-title-card" catchtap="stopPropagation">
      <view class="audio-title-kicker">AUDIO EXHIBIT</view>
      <view class="audio-title-heading">为声音留个名字</view>
      <view class="audio-title-copy">标题不是必填，也可以直接将这段声音入藏。</view>
      <view class="audio-title-field">
        <view class="audio-title-note">♪</view>
        <input
          value="{{audioTitleDraft}}"
          maxlength="30"
          focus="{{audioTitleDialogVisible}}"
          placeholder="例如：夏夜的雨声"
          confirm-type="done"
          bindinput="updateAudioTitleDraft"
          bindconfirm="confirmAudioTitle"
        />
      </view>
      <button class="audio-title-confirm" bindtap="confirmAudioTitle">{{audioTitleDraft ? '保存名字并入藏' : '直接入藏'}}</button>
      <button class="audio-title-skip" bindtap="skipAudioTitle">暂不命名</button>
    </view>
  </view>

  <view wx:if="{{hallSelectorVisible}}" class="hall-selector-mask {{tutorialTextCompleted ? 'tutorial-selector' : ''}}" bindtap="closeHallSelector">
    <view class="hall-selector-sheet" catchtap="stopPropagation">
      <view class="selector-handle"></view>
      <view class="selector-title">选择收藏展馆</view>
      <view class="selector-subtitle">内容将存入你选择的人生展馆</view>

      <scroll-view class="hall-option-list" style="height: {{hallOptionListHeight}}rpx;" scroll-y="true">
        <view
          wx:for="{{hallOptions}}"
          wx:key="name"
          class="hall-option {{index === selectedHallIndex ? 'selected' : ''}}"
          data-index="{{index}}"
          bindtap="selectHall"
        >
          <view class="hall-option-mark">馆</view>
          <view class="hall-option-name">{{item.name}}</view>
          <view wx:if="{{index === selectedHallIndex}}" class="hall-option-check">✓</view>
          <view wx:else class="hall-option-chevron">›</view>
        </view>
      </scroll-view>

      <view class="create-hall-option" bindtap="openHallCreator">
        <view class="create-hall-plus">＋</view>
        <view class="create-hall-copy">新建副馆</view>
        <view class="hall-option-chevron">›</view>
      </view>

      <button class="selector-cancel" bindtap="closeHallSelector">取消</button>
    </view>
  </view>

  <view wx:if="{{hallCreatorVisible}}" class="hall-creator-mask" bindtap="closeHallCreator">
    <view class="hall-creator-sheet" catchtap="stopPropagation">
      <view class="selector-handle"></view>
      <view class="creator-heading">
        <view>
          <view class="creator-kicker">NEW GALLERY</view>
          <view class="creator-title">创建一间副馆</view>
        </view>
        <view class="creator-close" bindtap="closeHallCreator">×</view>
      </view>
      <view class="creator-note">创建后，这件展品将直接收藏到新的副馆。</view>

      <view class="creator-field-label">副馆名称 <text>必填</text></view>
      <input class="creator-input" value="{{newHallName}}" maxlength="12" placeholder="例如：夏日碎片" bindinput="updateNewHallName" />

      <view class="creator-field-label">一句简介 <text>选填</text></view>
      <input class="creator-input" value="{{newHallDescription}}" maxlength="24" placeholder="这间展厅收藏着什么？" bindinput="updateNewHallDescription" />

      <view class="creator-field-label creator-cover-label">选择封面 <text>选填</text></view>
      <scroll-view class="creator-cover-list" scroll-x="true" show-scrollbar="false">
        <view class="creator-cover-row">
          <view class="creator-cover-choice default-cover-choice {{!selectedCover ? 'selected' : ''}}" bindtap="chooseDefaultCover">
            <view class="creator-small-arch"></view><text>默认</text>
          </view>
          <view wx:for="{{coverOptions}}" wx:key="*this" class="creator-cover-choice {{selectedCover === item ? 'selected' : ''}}" data-image="{{item}}" bindtap="chooseCover">
            <image src="{{item}}" mode="aspectFill"></image>
          </view>
        </view>
      </scroll-view>

      <view class="creator-actions">
        <button class="creator-cancel" bindtap="closeHallCreator">取消</button>
        <button class="creator-submit" loading="{{creatingHall}}" bindtap="submitNewHall">创建并选择</button>
      </view>
    </view>
  </view>

  <view wx:if="{{admissionAnimating}}" class="admission-room-wash" catchtap="stopPropagation"></view>
</view>
