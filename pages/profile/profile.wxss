.profile-page { min-height: 100vh; padding: 0 54rpx 120rpx; box-sizing: border-box; background: linear-gradient(145deg,#f8f3eb,#e4d7c6); }
.status-space { height: 120rpx; }
.page-title { font-size: 58rpx; }
.identity-card { margin-top: 55rpx; display: flex; align-items: center; gap: 28rpx; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 50%; color: #fff8e9; background: #947044; display: flex; align-items: center; justify-content: center; font-size: 42rpx; border: 8rpx double #d2b98f; }
.name { font-size: 34rpx; }
.id { margin-top: 14rpx; color: #887763; font-size: 24rpx; }
.stat-card { margin-top: 44rpx; display: flex; align-items: center; justify-content: space-around; height: 170rpx; border-radius: 20rpx; background: rgba(250,246,239,.65); border: 1rpx solid #d0bfa8; box-shadow: 0 15rpx 42rpx rgba(70,48,25,.1); }
.stat-card view:not(.rule) { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.number { font-size: 48rpx; color: #805c2d; }
.rule { width: 1rpx; height: 80rpx; background: #cfb995; }
.menu { margin-top: 44rpx; overflow: hidden; border-radius: 20rpx; background: rgba(250,246,239,.68); border: 1rpx solid #d0bfa8; }
.menu-item { height: 96rpx; padding: 0 30rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid rgba(180,158,129,.35); }
.menu-item:last-child { border-bottom: 0; }
.back-home { margin-top: 42rpx; padding: 30rpx; text-align: center; color: #7d694f; }
