.profile-page {
  min-height: 100vh;
  padding: 0 54rpx 150rpx;
  box-sizing: border-box;
  color: #332d26;
  background:
    repeating-linear-gradient(28deg, rgba(116,88,55,.018) 0, rgba(116,88,55,.018) 1rpx, transparent 1rpx, transparent 9rpx),
    linear-gradient(145deg, #f8f3eb, #e4d7c6);
}

.profile-nav {
  margin: 0 -54rpx;
}

.profile-nav-row {
  position: relative;
}

.profile-back {
  position: absolute;
  left: 39rpx;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid #463d34;
  border-bottom: 4rpx solid #463d34;
  transform: translateY(-50%) rotate(45deg);
}

.page-title {
  margin-top: 20rpx;
  font-size: 58rpx;
  font-weight: 500;
  letter-spacing: 5rpx;
}

.identity-card {
  margin-top: 55rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border: 8rpx double #d2b98f;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff8e9;
  background: #947044;
  font-size: 42rpx;
  box-shadow: 0 10rpx 24rpx rgba(72,50,28,.16);
  overflow: hidden;
}
.avatar image { width: 100%; height: 100%; display: block; }

.identity-copy {
  min-width: 0;
}

.name {
  overflow: hidden;
  font-size: 34rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.id {
  margin-top: 14rpx;
  color: #887763;
  font-family: var(--font-numeral);
  font-size: 24rpx;
}

.cloud-login-card {
  position: relative;
  margin-top: 40rpx;
  padding: 31rpx 29rpx 25rpx;
  overflow: hidden;
  border: 1rpx solid rgba(154,115,67,.34);
  border-radius: 20rpx;
  text-align: center;
  background: repeating-linear-gradient(45deg,rgba(125,95,59,.018) 0,rgba(125,95,59,.018) 1rpx,transparent 1rpx,transparent 8rpx),linear-gradient(145deg,rgba(255,250,241,.88),rgba(232,216,192,.82));
  box-shadow: 0 15rpx 38rpx rgba(70,48,25,.11), inset 0 0 0 5rpx rgba(255,252,245,.38);
}
.cloud-login-title { color: #46382b; font-size: 29rpx; font-weight: 500; letter-spacing: 2rpx; }
.cloud-login-description { margin-top: 13rpx; color: #806e59; font-size: 21rpx; line-height: 1.65; }
.cloud-login-card button { width: 330rpx; height: 76rpx; margin: 24rpx auto 0; padding: 0; border-radius: 10rpx; color: #fffaf0; background: linear-gradient(135deg,#ad8651,#805a2d); font-family: var(--font-display); font-size: 25rpx; line-height: 76rpx; letter-spacing: 3rpx; }
.cloud-login-card button::after { border: 0; }
.cloud-connected-card { margin-top: 40rpx; padding: 25rpx 28rpx; display: flex; align-items: center; gap: 20rpx; border: 1rpx solid rgba(139,105,64,.27); border-radius: 16rpx; color: #544332; background: rgba(249,244,236,.58); }
.connected-mark { width: 46rpx; height: 46rpx; flex: none; border-radius: 50%; color: #fffaf0; background: #8d6b40; font-size: 23rpx; line-height: 46rpx; text-align: center; }
.cloud-connected-card text { font-size: 25rpx; font-weight: 500; }
.cloud-connected-card view view { margin-top: 6rpx; color: #8b7965; font-size: 19rpx; }
.connected-copy { min-width: 0; flex: 1; }
.cloud-connected-card button { width: 126rpx; height: 60rpx; margin: 0; padding: 0; flex: none; border: 1rpx solid rgba(145,76,59,.3); border-radius: 9rpx; color: #8e4f42; background: rgba(255,250,242,.58); font-family: var(--font-display); font-size: 20rpx; line-height: 58rpx; }
.cloud-connected-card button::after { border: 0; }

.menu {
  margin-top: 38rpx;
  overflow: hidden;
  border: 1rpx solid #d0bfa8;
  border-radius: 20rpx;
  background: rgba(250,246,239,.72);
  box-shadow: 0 15rpx 40rpx rgba(70,48,25,.09);
}

.menu-item {
  min-height: 124rpx;
  padding: 0 27rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid rgba(180,158,129,.35);
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-icon {
  width: 54rpx;
  height: 54rpx;
  flex: none;
  border: 1rpx solid rgba(139,105,64,.32);
  color: #85643d;
  background: rgba(226,211,190,.42);
  font-size: 21rpx;
  line-height: 54rpx;
  text-align: center;
}

.menu-copy {
  min-width: 0;
  margin-left: 22rpx;
  flex: 1;
  color: #453a2f;
  font-size: 29rpx;
  font-weight: 500;
}

.menu-copy text {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #92806b;
  font-size: 19rpx;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-arrow {
  margin-left: 16rpx;
  color: #917f69;
  font-size: 38rpx;
}

.privacy-note {
  margin-top: 38rpx;
  padding: 27rpx 30rpx;
  border-left: 3rpx solid rgba(148,105,53,.48);
  color: #897764;
  background: rgba(249,244,236,.34);
  font-size: 20rpx;
  line-height: 1.7;
}

.privacy-note-title {
  margin-bottom: 5rpx;
  color: #66533e;
  font-size: 23rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.about-note {
  margin-top: 18rpx;
}

.about-version {
  margin-top: 9rpx;
}
