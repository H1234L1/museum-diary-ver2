<view class="profile-page">
  <view class="status-space"></view>
  <view class="page-title">我的</view>
  <view class="identity-card">
    <view class="avatar">藏</view>
    <view>
      <view class="name">我的人生博物馆</view>
      <view class="id">馆员编号 No. 00021</view>
    </view>
  </view>
  <view class="stat-card">
    <view><text class="number">{{collectionCount}}</text><text>件展品</text></view>
    <view class="rule"></view>
    <view><text class="number">{{museumDays}}</text><text>天入馆</text></view>
  </view>
  <view class="menu">
    <view wx:for="{{items}}" wx:key="name" class="menu-item" data-name="{{item.name}}" bindtap="tapMenu">
      <text>{{item.icon}}　{{item.name}}</text><text>›</text>
    </view>
  </view>
  <view class="back-home" bindtap="openHome">返回主页</view>
  <museum-nav active="profile"></museum-nav>
  <view wx:if="{{toast}}" class="toast">{{toast}}</view>
</view>
