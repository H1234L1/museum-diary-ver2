<view class="profile-page">
  <view class="profile-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="profile-nav-row" style="height: {{navigationBarHeight}}px;">
      <view class="profile-back" bindtap="goBack" aria-label="返回"></view>
    </view>
  </view>

  <view class="page-title">我的</view>

  <view class="identity-card">
    <view class="avatar">
      <image wx:if="{{loggedIn && accountUser.avatarFileId}}" src="{{accountUser.avatarFileId}}" mode="aspectFill"></image>
      <text wx:else>藏</text>
    </view>
    <view class="identity-copy">
      <view class="name">{{loggedIn && accountUser.displayName ? accountUser.displayName : '我的人生博物馆'}}</view>
      <view class="id">{{loggedIn ? '微信账号已连接' : '私人馆藏空间'}}</view>
    </view>
  </view>

  <view wx:if="{{!loggedIn}}" class="cloud-login-card">
    <view class="cloud-login-copy">
      <view class="cloud-login-title">把人生博物馆保存得更久</view>
      <view class="cloud-login-description">登录微信账号，可在不同设备上继续查看你的日记。</view>
    </view>
    <button bindtap="openAccount">微信登录</button>
  </view>

  <view wx:else class="cloud-connected-card">
    <view class="connected-mark">✓</view>
    <view class="connected-copy"><text>云端账号已连接</text><view>你的微信身份已用于识别这座博物馆</view></view>
    <button bindtap="confirmLogout">退出登录</button>
  </view>

  <view class="menu">
    <view
      wx:for="{{items}}"
      wx:key="name"
      class="menu-item"
      data-name="{{item.name}}"
      bindtap="tapMenu"
    >
      <view class="menu-icon">{{item.icon}}</view>
      <view class="menu-copy">
        <view>{{item.name}}</view>
        <text>{{item.description}}</text>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view class="privacy-note">
    <view class="privacy-note-title">本地收藏</view>
    <view>当前馆藏仅保存在这台设备中。我们不会在未提示你的情况下上传内容。</view>
  </view>

  <view class="privacy-note about-note">
    <view class="privacy-note-title">关于人生博物馆</view>
    <view>收藏照片、文字与声音，把每一段值得记住的人生时刻，放进属于自己的私人博物馆。</view>
    <view class="about-version">当前版本：预览切换版</view>
  </view>

  <museum-nav active="profile"></museum-nav>
  <museum-account
    visible="{{accountVisible}}"
    purpose="登录后可保存云端馆藏，并在不同设备上继续访问"
    bind:cancel="closeAccount"
    bind:success="handleAccountSuccess"
  ></museum-account>
  <view wx:if="{{toast}}" class="toast">{{toast}}</view>
</view>
