.hall-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
  box-sizing: border-box;
  background: #eee5d9;
  color: #332d26;
}
.hall-header {
  padding: 0 38rpx 18rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg,#d7c1a2,#b99a70);
  border-radius: 0 0 34rpx 34rpx;
}
.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.back {
  width: 70rpx;
  font-size: 58rpx;
}
.header-title {
  font-size: 42rpx;
  letter-spacing: 7rpx;
}
.header-more {
  width: 70rpx;
  text-align: right;
  font-size: 30rpx;
  letter-spacing: 3rpx;
}
.filter-bar {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(249,245,238,.8);
  border-bottom: 1rpx solid rgba(130,101,67,.18);
}
.filter {
  position: relative;
  min-width: 100rpx;
  padding: 30rpx 5rpx 26rpx;
  text-align: center;
  color: #7b6d5e;
  font-size: 27rpx;
}
.filter.active {
  color: #825d2d;
  font-weight: 600;
}
.filter.active::after {
  content: "";
  position: absolute;
  left: 30%;
  right: 30%;
  bottom: 14rpx;
  height: 5rpx;
  border-radius: 4rpx;
  background: #9a6d31;
}
.tools-row {
  height: 92rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #786b5c;
  background: rgba(225,213,197,.72);
  font-size: 25rpx;
}
.tool {
  margin-left: 28rpx;
  color: #867765;
  font-size: 40rpx;
}
.active-grid {
  color: #8b632e;
}
.month-group {
  padding: 36rpx 28rpx 8rpx;
}
.empty-hall {
  margin: 70rpx 42rpx;
  padding: 65rpx 35rpx;
  text-align: center;
  border: 1rpx solid rgba(139,105,64,.3);
  border-radius: 24rpx;
  background: rgba(248,242,233,.76);
}
.empty-mark {
  color: #a47a43;
  font-size: 56rpx;
}
.empty-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  letter-spacing: 3rpx;
}
.empty-copy {
  margin-top: 14rpx;
  color: #7a6b5b;
  font-size: 23rpx;
  line-height: 1.7;
}
.empty-button {
  width: 260rpx;
  margin: 34rpx auto 0;
  padding: 18rpx 15rpx;
  border-radius: 10rpx;
  color: #fff9ef;
  background: #906832;
  font-size: 25rpx;
}
.month-heading {
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  font-size: 29rpx;
  font-weight: 600;
}
.month-heading text:last-child {
  color: #796b5c;
  font-size: 23rpx;
  font-weight: 400;
}
.exhibit-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}
.exhibit-tile {
  position: relative;
  height: 260rpx;
  overflow: hidden;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #ddd0bd;
  box-shadow: 0 4rpx 12rpx rgba(64,44,23,.1);
}
.tile-photo image {
  width: 100%;
  height: 100%;
  display: block;
}
.photo-shade {
  position: absolute;
  inset: 45% 0 0;
  background: linear-gradient(transparent,rgba(31,23,16,.74));
}
.photo-title {
  position: absolute;
  left: 13rpx;
  right: 10rpx;
  bottom: 13rpx;
  color: #fffaf1;
  font-size: 21rpx;
  line-height: 1.35;
}
.tile-text {
  padding: 18rpx 16rpx;
  background: linear-gradient(145deg,#e7dac8,#d7c4a8);
  border: 1rpx solid rgba(141,108,65,.25);
}
.text-title {
  display: -webkit-box;
  overflow: hidden;
  color: #3f352a;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.35;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.text-rule {
  width: 32rpx;
  height: 2rpx;
  margin: 12rpx 0;
  background: #9c784a;
}
.text-excerpt {
  display: -webkit-box;
  overflow: hidden;
  color: #665849;
  font-size: 20rpx;
  line-height: 1.55;
  -webkit-line-clamp: 5;
  -webkit-box-orient: vertical;
}
.text-ellipsis {
  position: absolute;
  left: 16rpx;
  bottom: 8rpx;
  color: #8e785f;
}
.tile-audio {
  padding: 18rpx 12rpx;
  background: linear-gradient(150deg,#d5c09f,#b99b70);
  border: 1rpx solid #ad8b5e;
}
.audio-title {
  position: relative;
  z-index: 2;
  height: 62rpx;
  overflow: hidden;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}
.headphones {
  position: absolute;
  left: 50%;
  top: 90rpx;
  width: 100rpx;
  height: 94rpx;
  transform: translateX(-50%);
}
.headband {
  position: absolute;
  left: 10rpx;
  top: 0;
  width: 74rpx;
  height: 74rpx;
  box-sizing: border-box;
  border: 10rpx solid #6f5637;
  border-bottom: 0;
  border-radius: 50rpx 50rpx 0 0;
}
.ear {
  position: absolute;
  top: 52rpx;
  width: 24rpx;
  height: 39rpx;
  border-radius: 10rpx;
  background: #6f5637;
}
.ear-left { left: 0; }
.ear-right { right: 0; }
.audio-duration {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 17rpx;
  text-align: center;
  color: #665039;
  font-family: Georgia, serif;
  font-size: 19rpx;
}
.hall-bottom-space {
  height: 30rpx;
}
