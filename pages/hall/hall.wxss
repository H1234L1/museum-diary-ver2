.hall-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
  box-sizing: border-box;
  background: #eee5d9;
  color: #332d26;
}
.hall-header {
  padding: 0 38rpx 25rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg,#d7c1a2,#b99a70);
  border-radius: 0 0 34rpx 34rpx;
}
.header-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.back {
  width: 70rpx;
  font-size: 58rpx;
}
.header-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 42rpx;
  letter-spacing: 7rpx;
}
.header-spacer {
  width: 70rpx;
}
.overview-switch-row {
  height: 62rpx;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.overview-switch {
  box-sizing: border-box;
  width: 210rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid rgba(91,67,40,.32);
  border-radius: 28rpx;
  background: rgba(248,241,230,.66);
  color: #5f4b34;
  font-size: 18rpx;
  line-height: 1.25;
  letter-spacing: 1rpx;
  text-align: center;
}
.header-more {
  width: 70rpx;
  text-align: right;
  font-size: 30rpx;
  letter-spacing: 3rpx;
}
.filter-bar {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(249,245,238,.8);
  border-bottom: 1rpx solid rgba(130,101,67,.18);
}
.filter {
  position: relative;
  min-width: 100rpx;
  padding: 30rpx 5rpx 26rpx;
  text-align: center;
  color: #7b6d5e;
  font-size: 27rpx;
}
.filter.active {
  color: #825d2d;
  font-weight: 600;
}
.filter.active::after {
  content: "";
  position: absolute;
  left: 30%;
  right: 30%;
  bottom: 14rpx;
  height: 5rpx;
  border-radius: 4rpx;
  background: #9a6d31;
}
.tools-row {
  height: 92rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #786b5c;
  background: rgba(225,213,197,.72);
  font-size: 25rpx;
}
.tools-actions {
  height: 100%;
  display: flex;
  align-items: center;
  gap: 29rpx;
}
.tool {
  color: #867765;
  font-size: 40rpx;
}
.move-trigger {
  height: 56rpx;
  padding: 0 15rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border: 1rpx solid rgba(126,93,54,.25);
  border-radius: 28rpx;
  color: #81633f;
  background: rgba(250,245,237,.38);
  font-size: 20rpx;
}
.move-trigger.active {
  border-color: rgba(133,91,40,.55);
  background: rgba(161,118,62,.15);
}
.move-glyph {
  position: relative;
  width: 31rpx;
  height: 29rpx;
}
.move-box {
  position: absolute;
  left: 1rpx;
  bottom: 1rpx;
  width: 20rpx;
  height: 18rpx;
  border: 2rpx solid #82633e;
}
.move-arrow {
  position: absolute;
  right: 1rpx;
  top: 1rpx;
  width: 14rpx;
  height: 14rpx;
  border-top: 2rpx solid #82633e;
  border-right: 2rpx solid #82633e;
}
.month-group {
  padding: 36rpx 28rpx 8rpx;
}
.empty-hall {
  margin: 70rpx 42rpx;
  padding: 65rpx 35rpx;
  text-align: center;
  border: 1rpx solid rgba(139,105,64,.3);
  border-radius: 24rpx;
  background: rgba(248,242,233,.76);
}
.empty-mark {
  color: #a47a43;
  font-size: 56rpx;
}
.empty-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  letter-spacing: 3rpx;
}
.empty-copy {
  margin-top: 14rpx;
  color: #7a6b5b;
  font-size: 23rpx;
  line-height: 1.7;
}
.empty-button {
  width: 260rpx;
  margin: 34rpx auto 0;
  padding: 18rpx 15rpx;
  border-radius: 10rpx;
  color: #fff9ef;
  background: #906832;
  font-size: 25rpx;
}
.month-heading {
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  font-size: 29rpx;
  font-weight: 600;
}
.month-heading text:last-child {
  color: #796b5c;
  font-size: 23rpx;
  font-weight: 400;
}
.exhibit-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}
.exhibit-tile {
  position: relative;
  height: 260rpx;
  overflow: hidden;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #ddd0bd;
  box-shadow: 0 4rpx 12rpx rgba(64,44,23,.1);
}
.exhibit-tile.selected {
  box-shadow: 0 0 0 5rpx rgba(155,108,48,.62), 0 8rpx 19rpx rgba(68,45,22,.18);
}
.selection-marker {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  z-index: 8;
  width: 37rpx;
  height: 37rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255,250,241,.86);
  border-radius: 50%;
  background: rgba(61,48,35,.27);
  color: #fffaf0;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
  box-shadow: 0 3rpx 8rpx rgba(40,28,17,.18);
}
.selection-marker.checked {
  border-color: #9b713a;
  background: #9b713a;
}
.tile-photo image {
  width: 100%;
  height: 100%;
  display: block;
}
.photo-shade {
  position: absolute;
  inset: 45% 0 0;
  background: linear-gradient(transparent,rgba(31,23,16,.74));
}
.photo-title {
  position: absolute;
  left: 13rpx;
  right: 10rpx;
  bottom: 13rpx;
  color: #fffaf1;
  font-size: 21rpx;
  line-height: 1.35;
}
.tile-text {
  padding: 18rpx 16rpx;
  background: linear-gradient(145deg,#e7dac8,#d7c4a8);
  border: 1rpx solid rgba(141,108,65,.25);
}
.text-title {
  display: -webkit-box;
  overflow: hidden;
  color: #3f352a;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.35;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.text-rule {
  width: 32rpx;
  height: 2rpx;
  margin: 12rpx 0;
  background: #9c784a;
}
.text-excerpt {
  display: -webkit-box;
  overflow: hidden;
  color: #665849;
  font-size: 20rpx;
  line-height: 1.55;
  -webkit-line-clamp: 5;
  -webkit-box-orient: vertical;
}
.text-ellipsis {
  position: absolute;
  left: 16rpx;
  bottom: 8rpx;
  color: #8e785f;
}
.tile-audio {
  padding: 18rpx 12rpx;
  background: linear-gradient(150deg,#d5c09f,#b99b70);
  border: 1rpx solid #ad8b5e;
}
.audio-title {
  position: relative;
  z-index: 2;
  height: 62rpx;
  overflow: hidden;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}
.headphones {
  position: absolute;
  left: 50%;
  top: 90rpx;
  width: 100rpx;
  height: 94rpx;
  transform: translateX(-50%);
}
.headband {
  position: absolute;
  left: 10rpx;
  top: 0;
  width: 74rpx;
  height: 74rpx;
  box-sizing: border-box;
  border: 10rpx solid #6f5637;
  border-bottom: 0;
  border-radius: 50rpx 50rpx 0 0;
}
.ear {
  position: absolute;
  top: 52rpx;
  width: 24rpx;
  height: 39rpx;
  border-radius: 10rpx;
  background: #6f5637;
}
.ear-left { left: 0; }
.ear-right { right: 0; }
.audio-duration {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 17rpx;
  text-align: center;
  color: #665039;
  font-family: Georgia, serif;
  font-size: 19rpx;
}
.hall-bottom-space {
  height: 150rpx;
}
.selection-dock {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  z-index: 90;
  height: 94rpx;
  padding: 0 18rpx 0 27rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(117,84,47,.30);
  border-radius: 20rpx;
  background: rgba(244,237,226,.93);
  box-shadow: 0 14rpx 34rpx rgba(55,38,23,.18), inset 0 1rpx rgba(255,255,255,.72);
  -webkit-backdrop-filter: blur(14rpx);
  backdrop-filter: blur(14rpx);
}
.selection-summary {
  color: #695741;
  font-size: 23rpx;
}
.selection-summary text {
  margin: 0 5rpx;
  color: #94672f;
  font-family: var(--font-numeral);
  font-size: 30rpx;
}
.move-button {
  width: 260rpx;
  height: 65rpx;
  margin: 0;
  padding: 0;
  border-radius: 10rpx;
  background: #c9baa5;
  color: rgba(255,250,241,.78);
  font-family: var(--font-display);
  font-size: 22rpx;
  line-height: 65rpx;
}
.move-button.ready {
  background: #95682f;
  color: #fffaf0;
}
.move-button::after {
  border: 0;
}
.move-mask {
  position: fixed;
  inset: 0;
  z-index: 220;
  display: flex;
  align-items: flex-end;
  background: rgba(42,34,27,.46);
}
.move-sheet {
  width: 100%;
  max-height: 70vh;
  padding: 17rpx 35rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background: #f2eadf;
  box-shadow: 0 -18rpx 45rpx rgba(42,30,19,.20);
}
.sheet-handle {
  width: 70rpx;
  height: 7rpx;
  margin: 0 auto 27rpx;
  border-radius: 5rpx;
  background: rgba(108,85,59,.28);
}
.move-sheet-title {
  color: #3f352b;
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
  text-align: center;
}
.move-sheet-copy {
  margin-top: 10rpx;
  color: #8a7762;
  font-size: 21rpx;
  text-align: center;
}
.target-list {
  max-height: 34vh;
  margin-top: 27rpx;
  overflow: hidden;
  border: 1rpx solid rgba(129,99,63,.22);
  border-radius: 14rpx;
  background: rgba(255,251,244,.55);
}
.target-row {
  height: 94rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid rgba(132,105,73,.17);
}
.target-row:last-child {
  border-bottom: 0;
}
.target-mark {
  width: 49rpx;
  height: 49rpx;
  border: 1rpx solid rgba(139,101,57,.37);
  color: #8b6539;
  font-size: 21rpx;
  line-height: 49rpx;
  text-align: center;
}
.target-name {
  flex: 1;
  margin-left: 20rpx;
  color: #4e4134;
  font-size: 26rpx;
}
.target-arrow {
  color: #9a856d;
  font-size: 38rpx;
}
.create-target-row {
  height: 104rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border: 1rpx dashed rgba(139,101,57,.45);
  border-radius: 14rpx;
  background: rgba(222,205,181,.34);
}
.create-target-plus {
  width: 49rpx;
  height: 49rpx;
  color: #8b6539;
  font-family: var(--font-numeral);
  font-size: 46rpx;
  font-weight: 300;
  line-height: 49rpx;
  text-align: center;
}
.create-target-copy {
  flex: 1;
  margin-left: 20rpx;
  color: #584735;
  font-size: 26rpx;
}
.sheet-cancel {
  height: 72rpx;
  margin: 22rpx 0 0;
  padding: 0;
  border: 1rpx solid rgba(124,94,59,.22);
  border-radius: 11rpx;
  background: rgba(255,251,244,.60);
  color: #75624d;
  font-family: var(--font-display);
  font-size: 25rpx;
  line-height: 72rpx;
}
.sheet-cancel::after {
  border: 0;
}
.creator-mask { position: fixed; inset: 0; z-index: 230; display: flex; align-items: flex-end; background: rgba(39,31,24,.52); }
.creator-sheet { width: 100%; max-height: 90vh; padding: 18rpx 42rpx calc(34rpx + env(safe-area-inset-bottom)); box-sizing: border-box; overflow-y: auto; border-radius: 34rpx 34rpx 0 0; background: linear-gradient(155deg,#faf6ef,#eee3d5); box-shadow: 0 -18rpx 45rpx rgba(37,27,18,.2); }
.creator-heading { display: flex; justify-content: space-between; align-items: flex-start; }
.creator-kicker { margin-bottom: 10rpx; color: #a08461; font-family: var(--font-numeral); font-size: 18rpx; letter-spacing: 3rpx; }
.creator-title { font-size: 42rpx; font-weight: 500; letter-spacing: 4rpx; }
.creator-close { width: 60rpx; height: 60rpx; line-height: 54rpx; text-align: center; border: 1rpx solid rgba(122,94,61,.25); border-radius: 50%; color: #715d46; font-size: 40rpx; }
.creator-note { margin: 20rpx 0 34rpx; color: #8a7762; font-size: 24rpx; line-height: 1.7; }
.field-label { margin: 24rpx 0 12rpx; color: #493b2d; font-size: 25rpx; font-weight: 500; }
.field-label text { margin-left: 10rpx; color: #a38e76; font-size: 19rpx; font-weight: 400; }
.hall-input { height: 80rpx; padding: 0 23rpx; border: 1rpx solid rgba(137,104,64,.3); border-radius: 10rpx; background: rgba(255,252,246,.68); color: #342a20; font-family: var(--font-display); font-size: 27rpx; }
.cover-label { margin-top: 30rpx; }
.cover-list { width: calc(100% + 42rpx); }
.cover-row { display: flex; gap: 16rpx; padding: 2rpx 42rpx 6rpx 2rpx; }
.cover-choice { position: relative; flex: none; width: 126rpx; height: 126rpx; box-sizing: border-box; overflow: hidden; border: 3rpx solid transparent; border-radius: 12rpx; background: #d5c4ac; }
.cover-choice.selected { border-color: #99703c; box-shadow: 0 0 0 3rpx rgba(153,112,60,.14); }
.cover-choice image { width: 100%; height: 100%; display: block; }
.default-choice { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #6e5940; }
.small-arch { width: 45rpx; height: 53rpx; border: 2rpx solid #8c6c45; border-bottom: 0; border-radius: 28rpx 28rpx 0 0; }
.default-choice text { margin-top: 8rpx; font-size: 19rpx; }
.creator-actions { margin-top: 38rpx; display: flex; gap: 18rpx; }
.creator-actions button { height: 82rpx; margin: 0; padding: 0; flex: 1; line-height: 82rpx; border-radius: 10rpx; font-family: var(--font-display); font-size: 27rpx; font-weight: 500; }
.creator-actions button::after { border: 0; }
.cancel-button { border: 1rpx solid rgba(128,96,57,.3); background: rgba(255,250,242,.58); color: #705d47; }
.create-button { background: linear-gradient(135deg,#ad8651,#8c642f); color: #fffaf0; box-shadow: 0 9rpx 18rpx rgba(101,70,31,.18); }
