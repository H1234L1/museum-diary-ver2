<view class="hall-page">
  <view class="hall-header" style="padding-top: calc({{statusBarHeight}}px + 18rpx);">
    <view class="header-row" style="height: {{navigationBarHeight}}px;">
      <view class="back" bindtap="goBack">‹</view>
      <view class="header-title">{{hallName}}</view>
      <view class="header-spacer"></view>
    </view>
    <view class="overview-switch-row">
      <view class="museum-mode-switch">
        <view class="mode-option" bindtap="openShowcase">展馆空间</view>
        <view class="mode-divider"></view>
        <view class="mode-option active">藏品管理</view>
      </view>
    </view>
  </view>

  <view wx:if="{{filterMenuVisible}}" class="filter-menu-mask" bindtap="closeFilterMenu"></view>

  <view class="search-tools-row">
    <view class="search-field">
      <view class="search-glyph"></view>
      <input
        class="search-input"
        value="{{searchQuery}}"
        placeholder="搜索馆藏"
        confirm-type="search"
        bindinput="handleSearchInput"
      />
      <view wx:if="{{searchQuery}}" class="search-clear" bindtap="clearSearch">×</view>
    </view>

    <view class="filter-trigger {{activeFilter !== '全部' ? 'active' : ''}}" bindtap="toggleFilterMenu">
      <view class="filter-lines">
        <view class="filter-line line-one"></view>
        <view class="filter-line line-two"></view>
        <view class="filter-line line-three"></view>
      </view>
    </view>

    <view wx:if="{{filterMenuVisible}}" class="filter-popover" catchtap="noop">
      <view class="filter-popover-title">筛选展品</view>
      <view
        wx:for="{{filterOptions}}"
        wx:key="*this"
        class="filter-option {{activeFilter === item ? 'active' : ''}}"
        data-filter="{{item}}"
        bindtap="selectFilter"
      >
        <text>{{item}}</text>
        <text wx:if="{{activeFilter === item}}" class="filter-check">✓</text>
      </view>
    </view>
  </view>

  <view wx:if="{{groups.length === 0}}" class="empty-hall">
    <view class="empty-mark">◇</view>
    <view class="empty-title">{{hasActiveFilter ? '没有找到匹配的展品' : hallName + '还没有展品'}}</view>
    <view class="empty-copy">{{hasActiveFilter ? '试试更换筛选类型或搜索关键词。' : '收藏你的第一个人生片刻，它会出现在这里。'}}</view>
    <navigator wx:if="{{!hasActiveFilter}}" class="empty-button" url="/pages/record/record?new=1" open-type="redirect">收藏一件展品</navigator>
  </view>

  <view wx:for="{{groups}}" wx:key="month" class="month-group">
    <view class="month-heading">
      <text>{{item.month}}</text>
      <text>{{item.count}} 件</text>
    </view>
    <view class="exhibit-grid">
      <view
        wx:for="{{item.items}}"
        wx:for-item="exhibit"
        wx:key="id"
        class="exhibit-tile tile-{{exhibit.type}} {{selectedMap[exhibit.id] ? 'selected' : ''}}"
        data-id="{{exhibit.id}}"
        data-type="{{exhibit.type}}"
        bindtap="handleExhibitTap"
        bindlongpress="handleExhibitLongPress"
      >
        <view wx:if="{{selecting}}" class="selection-marker {{selectedMap[exhibit.id] ? 'checked' : ''}}">
          {{selectedMap[exhibit.id] ? '✓' : ''}}
        </view>
        <block wx:if="{{exhibit.type === 'photo'}}">
          <image src="{{exhibit.image}}" mode="aspectFill"></image>
          <view class="photo-shade"></view>
          <view wx:if="{{exhibit.title}}" class="photo-title">{{exhibit.title}}</view>
        </block>
        <block wx:elif="{{exhibit.type === 'text'}}">
          <view class="text-excerpt">{{exhibit.excerpt}}</view>
          <view class="text-ellipsis">…</view>
        </block>
        <block wx:else>
          <view class="audio-title">{{exhibit.title}}</view>
          <view class="headphones">
            <view class="headband"></view>
            <view class="ear ear-left"></view>
            <view class="ear ear-right"></view>
          </view>
          <view class="audio-duration">{{exhibit.duration}}</view>
        </block>
      </view>
    </view>
  </view>

  <view class="hall-bottom-space"></view>

  <view wx:if="{{totalItemCount}}" class="move-fab {{selecting ? 'active' : ''}}" bindtap="toggleSelectionMode">
    <view class="move-glyph"><view class="move-box"></view><view class="move-arrow"></view></view>
    <text>{{selecting ? '取消' : '移馆'}}</text>
  </view>

  <view wx:if="{{selecting}}" class="selection-dock">
    <view class="selection-actions">
      <button class="delete-selected-button {{selectedCount ? 'ready' : ''}}" bindtap="confirmDeleteSelected">删除</button>
      <button class="move-button {{selectedCount ? 'ready' : ''}}" bindtap="openMoveTargets">移馆</button>
    </view>
  </view>

  <museum-nav active="gallery"></museum-nav>
  <museum-guide id="museumGuide" bind:action="handleTutorialAction"></museum-guide>

  <view wx:if="{{targetSheetVisible}}" class="move-mask" bindtap="closeTargetSheet">
    <view class="move-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="move-sheet-title">移动到其他博物馆</view>
      <view class="move-sheet-copy">选择这 {{selectedCount}} 件展品的新归属</view>
      <scroll-view class="target-list" scroll-y="{{true}}" show-scrollbar="{{false}}">
        <view
          wx:for="{{moveTargets}}"
          wx:key="name"
          class="target-row"
          data-index="{{index}}"
          bindtap="confirmMove"
        >
          <view class="target-mark">馆</view>
          <view class="target-name">{{item.name}}</view>
          <view class="target-arrow">›</view>
        </view>
      </scroll-view>
      <view class="create-target-row" bindtap="createHallAndMove">
        <view class="create-target-plus">＋</view>
        <view class="create-target-copy">
          <view>新建副馆</view>
        </view>
        <view class="target-arrow">›</view>
      </view>
      <button class="sheet-cancel" bindtap="closeTargetSheet" disabled="{{moving}}">取消</button>
    </view>
  </view>

  <view wx:if="{{creatorVisible}}" class="creator-mask" bindtap="closeCreator">
    <view class="creator-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="creator-heading">
        <view>
          <view class="creator-kicker">NEW GALLERY</view>
          <view class="creator-title">创建一间副馆</view>
        </view>
        <view class="creator-close" bindtap="closeCreator">×</view>
      </view>
      <view class="creator-note">为所选展品创建一个新的归属。</view>

      <view class="field-label">副馆名称 <text>必填</text></view>
      <input
        class="hall-input"
        value="{{newHallName}}"
        maxlength="12"
        placeholder="例如：夏日碎片"
        bindinput="updateNewHallName"
      />

      <view class="field-label">一句简介 <text>选填</text></view>
      <input
        class="hall-input"
        value="{{newHallDescription}}"
        maxlength="24"
        placeholder="这间展厅收藏着什么？"
        bindinput="updateNewHallDescription"
      />

      <view class="field-label cover-label">选择封面 <text>选填</text></view>
      <scroll-view class="cover-list" scroll-x="{{true}}" show-scrollbar="{{false}}">
        <view class="cover-row">
          <view class="cover-choice default-choice {{!selectedCover ? 'selected' : ''}}" bindtap="chooseDefaultCover">
            <view class="small-arch"></view><text>默认</text>
          </view>
          <view
            wx:for="{{coverOptions}}"
            wx:key="*this"
            class="cover-choice {{selectedCover === item ? 'selected' : ''}}"
            data-image="{{item}}"
            bindtap="chooseCover"
          >
            <image src="{{item}}" mode="aspectFill"></image>
          </view>
        </view>
      </scroll-view>

      <view class="creator-actions">
        <button class="cancel-button" bindtap="closeCreator">取消</button>
        <button class="create-button" loading="{{creating}}" bindtap="submitNewHallAndMove">创建并移动</button>
      </view>
    </view>
  </view>
</view>
