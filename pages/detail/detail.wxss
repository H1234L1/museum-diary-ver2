.showcase-actions .share-action-icon { position: relative; width: 48rpx; height: 39rpx; margin-bottom: 5rpx; }
.share-arrow-shaft { position: absolute; left: 1rpx; bottom: 1rpx; width: 31rpx; height: 25rpx; box-sizing: border-box; border-top: 5rpx solid #29231d; border-left: 5rpx solid #29231d; border-radius: 25rpx 0 0 0; transform: skewY(-7deg); }
.share-arrow-head { position: absolute; top: 0; right: 3rpx; width: 22rpx; height: 22rpx; box-sizing: border-box; border-top: 5rpx solid #29231d; border-right: 5rpx solid #29231d; transform: rotate(45deg); border-radius: 2rpx; }
