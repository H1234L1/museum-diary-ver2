<view class="detail-page static-detail {{type === 'photo' ? 'photo-detail' : ''}} {{type === 'audio' ? 'audio-detail' : ''}}">
  <view class="detail-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="detail-nav-row" style="height: {{navigationBarHeight}}px;">
      <view class="back" bindtap="goBack">‹</view>
      <view class="detail-nav-title">展品详情</view>
      <view class="top-more" bindtap="showActions">•••</view>
    </view>
  </view>

  <view class="gallery-light">
    <view wx:if="{{type === 'photo'}}" class="photo-exhibit" style="height: {{textGalleryHeight}}px;">
      <view class="gallery-ceiling"></view>
      <view class="spotlight-fixture"><view class="spotlight-rim"></view><view class="spotlight-bulb"></view></view>
      <view class="spotlight-beam photo-beam"></view>

      <view class="photo-scene-content">
        <view class="exhibit-number">No. {{exhibitNumber}}</view>
        <view class="museum-frame">
          <view class="frame-bevel">
            <view class="frame-mat">
              <view class="photo-window">
                <image wx:if="{{record && record.image}}" src="{{record.image}}" mode="aspectFill"></image>
                <view wx:else class="empty-exhibit">尚未放入照片</view>
              </view>
            </view>
          </view>
        </view>

        <view class="description-card photo-card">
          <view wx:if="{{record && record.date}}" class="exhibit-date">{{displayDate}} 入藏</view>
          <view wx:if="{{record && record.story}}" class="exhibit-description">{{record.story}}</view>
          <view class="hall-link">所属展厅 <text>{{record && record.hall ? record.hall : '主馆'}}　›</text></view>
        </view>
      </view>
    </view>

    <view wx:if="{{type === 'text'}}" class="text-exhibit" style="height: {{textGalleryHeight}}px;">
      <view class="gallery-ceiling"></view>
      <view class="spotlight-fixture"><view class="spotlight-rim"></view><view class="spotlight-bulb"></view></view>
      <view class="spotlight-beam text-beam"></view>

      <view class="text-scene-content">
        <view class="exhibit-number">No. {{exhibitNumber}}</view>
        <view class="scroll-paper">
          <view class="paper-roll paper-roll-top"></view>
          <view class="exhibit-date">{{displayDate}} 入藏</view>
          <view class="tiny-ornament">— ◇ —</view>
          <scroll-view class="story-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
            <view wx:if="{{record}}" class="story"><text>{{record.story}}</text></view>
            <view wx:else class="story">
              <text>傍晚从图书馆回家的路上，天空被落日染成了橘红色。</text>
              <text>风很轻，树叶沙沙响，城市好像也慢了下来。</text>
              <text>那一刻突然觉得，平凡的一天也可以这么美。</text>
              <text>原来幸福不是很大的事情，而是这些被忽略的、微小的瞬间。</text>
            </view>
          </scroll-view>
          <view class="paper-roll paper-roll-bottom"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{type === 'audio'}}" class="audio-exhibit" style="height: {{textGalleryHeight}}px;">
      <view class="gallery-ceiling"></view>
      <view class="spotlight-fixture"><view class="spotlight-rim"></view><view class="spotlight-bulb"></view></view>
      <view class="spotlight-beam audio-beam"></view>

      <view class="audio-scene-content">
        <view class="exhibit-number">No. {{exhibitNumber}}</view>

        <view class="gramophone-artifact" aria-label="留声机展品">
          <image class="gramophone-image" src="/assets/art/gramophone-cutout.png" mode="aspectFit"></image>
          <view class="artifact-contact-shadow"></view>
          <view class="museum-shelf">
            <view class="shelf-top"></view>
            <view class="shelf-front"></view>
            <view class="shelf-support shelf-support-left"></view>
            <view class="shelf-support shelf-support-right"></view>
            <view class="shelf-shadow"></view>
          </view>
        </view>

        <view class="description-card audio-card">
        <view class="exhibit-title">{{record ? record.title : '夜里的留言'}}</view>
        <view class="exhibit-date">{{displayDate}} 入藏</view>
        <view wx:if="{{record && record.story}}" class="exhibit-description">{{record.story}}</view>
        <view class="audio-control" bindtap="toggleAudio">
          <view class="audio-control-icon">{{playing ? 'Ⅱ' : '▶'}}</view>
        </view>
        <view class="hall-link">所属展厅 <text>{{record ? record.hall : '主馆'}}　›</text></view>
        </view>
      </view>
    </view>
  </view>

  <view class="detail-actions showcase-actions">
    <view class="action-button" bindtap="editItem"><view class="action-icon edit-action-icon">✎</view><text>编辑</text></view>
    <view class="action-button" bindtap="comment"><view class="action-icon">○</view><text>留言</text></view>
    <button open-type="share"><view class="action-icon share-action-icon"><view class="share-arrow-shaft"></view><view class="share-arrow-head"></view></view><text>分享</text></button>
  </view>
  <view wx:if="{{toast}}" class="toast">{{toast}}</view>
</view>
