<view class="detail-page static-detail {{type === 'photo' ? 'photo-detail' : ''}} {{type === 'audio' ? 'audio-detail' : ''}}">
  <view class="detail-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="detail-nav-row" style="height: {{navigationBarHeight}}px;">
      <view class="back" bindtap="goBack">‹</view>
      <view class="detail-nav-title">展品详情</view>
      <view class="detail-nav-spacer"></view>
    </view>
  </view>

  <view class="gallery-light">
    <view wx:if="{{!isSharedViewer}}" class="showcase-menu-wrap">
      <view class="showcase-menu-trigger" bindtap="toggleActionsMenu">•••</view>
      <view wx:if="{{actionsMenuVisible}}" class="showcase-menu">
        <view class="showcase-menu-item" bindtap="editItem"><text class="menu-edit-icon">✎</text>编辑</view>
        <view class="showcase-menu-item delete-menu-item" bindtap="confirmDelete"><text class="menu-delete-icon">×</text>删除</view>
        <button
          class="showcase-menu-item"
          open-type="{{shareToken ? 'share' : ''}}"
          bindtap="handleShareTap"
        ><text class="menu-share-icon">↗</text>分享</button>
      </view>
    </view>

    <view wx:if="{{type === 'photo'}}" class="photo-exhibit" style="height: {{textGalleryHeight}}px;">
      <view class="gallery-ceiling"></view>
      <view class="spotlight-fixture"><view class="spotlight-rim"></view><view class="spotlight-bulb"></view></view>
      <view class="spotlight-beam photo-beam"></view>

      <view class="photo-scene-content">
        <view class="exhibit-number">No. {{exhibitNumber}}</view>
        <view class="museum-frame">
          <view class="frame-bevel">
            <view class="frame-mat">
              <view class="photo-window">
                <image wx:if="{{record && record.image}}" src="{{record.image}}" mode="aspectFill"></image>
                <view wx:else class="empty-exhibit">尚未放入照片</view>
              </view>
            </view>
          </view>
        </view>

        <view class="description-card photo-card">
          <view wx:if="{{record && record.date}}" class="exhibit-date">{{displayDate}} 入藏</view>
          <view wx:if="{{record && record.story}}" class="photo-story-preview">{{record.story}}</view>
          <view wx:if="{{photoStoryExpandable}}" class="photo-story-expand" bindtap="openPhotoStory">… 展开</view>
          <view class="hall-link">所属展厅 <text>{{record && record.hall ? record.hall : '主馆'}}　›</text></view>
        </view>
      </view>
    </view>

    <view wx:if="{{type === 'text'}}" class="text-exhibit" style="height: {{textGalleryHeight}}px;">
      <view class="gallery-ceiling"></view>
      <view class="spotlight-fixture"><view class="spotlight-rim"></view><view class="spotlight-bulb"></view></view>
      <view class="spotlight-beam text-beam"></view>

      <view class="text-scene-content">
        <view class="exhibit-number">No. {{exhibitNumber}}</view>
        <view class="scroll-paper">
          <view class="paper-roll paper-roll-top"></view>
          <view class="exhibit-date">{{displayDate}} 入藏</view>
          <view class="tiny-ornament">— ◇ —</view>
          <scroll-view class="story-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
            <view wx:if="{{record}}" class="story"><text>{{record.story}}</text></view>
            <view wx:else class="story">
              <text>傍晚从图书馆回家的路上，天空被落日染成了橘红色。</text>
              <text>风很轻，树叶沙沙响，城市好像也慢了下来。</text>
              <text>那一刻突然觉得，平凡的一天也可以这么美。</text>
              <text>原来幸福不是很大的事情，而是这些被忽略的、微小的瞬间。</text>
            </view>
          </scroll-view>
          <view class="paper-roll paper-roll-bottom"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{type === 'audio'}}" class="audio-exhibit" style="height: {{textGalleryHeight}}px;">
      <view class="gallery-ceiling"></view>
      <view class="spotlight-fixture"><view class="spotlight-rim"></view><view class="spotlight-bulb"></view></view>
      <view class="spotlight-beam audio-beam"></view>

      <view class="audio-scene-content">
        <view class="exhibit-number">No. {{exhibitNumber}}</view>

        <view class="gramophone-artifact" aria-label="留声机展品">
          <image class="gramophone-image" src="/assets/art/gramophone-cutout.png" mode="aspectFit"></image>
          <view class="artifact-contact-shadow"></view>
          <view class="museum-shelf">
            <view class="shelf-top"></view>
            <view class="shelf-front"></view>
            <view class="shelf-support shelf-support-left"></view>
            <view class="shelf-support shelf-support-right"></view>
            <view class="shelf-shadow"></view>
          </view>
        </view>

        <view class="description-card audio-card">
        <view class="exhibit-title">{{record ? record.title : '夜里的留言'}}</view>
        <view class="exhibit-date">{{displayDate}} 入藏</view>
        <view wx:if="{{record && record.story}}" class="exhibit-description">{{record.story}}</view>
        <view class="audio-control" bindtap="toggleAudio">
          <view class="audio-control-icon">{{playing ? 'Ⅱ' : '▶'}}</view>
        </view>
        <view class="hall-link">所属展厅 <text>{{record ? record.hall : '主馆'}}　›</text></view>
        </view>
      </view>
    </view>
  </view>

  <view class="floating-comment" bindtap="comment">
    <view class="floating-comment-icon"></view>
    <text>留言</text>
  </view>
  <view wx:if="{{photoStoryVisible}}" class="photo-story-mask" bindtap="closePhotoStory"></view>
  <view wx:if="{{photoStoryVisible}}" class="photo-story-reader" catchtap="noop">
    <view class="photo-story-reader-topline"></view>
    <view class="photo-story-reader-header">
      <view>
        <view class="photo-story-reader-kicker">EXHIBIT NOTE</view>
        <view class="photo-story-reader-date">{{displayDate}} 入藏</view>
      </view>
      <view class="photo-story-reader-close" bindtap="closePhotoStory">×</view>
    </view>
    <view class="photo-story-reader-rule"><text></text><view>◇</view><text></text></view>
    <scroll-view class="photo-story-reader-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="photo-story-reader-text">{{record.story}}</view>
    </scroll-view>
    <view class="photo-story-reader-footer">人生博物馆 · 私藏手记</view>
  </view>
  <view wx:if="{{commentsVisible}}" class="comment-mask" bindtap="closeComments"></view>
  <view wx:if="{{commentsVisible}}" class="comment-sheet" catchtap="noop">
    <view class="comment-sheet-handle"></view>
    <view class="comment-sheet-header">
      <view class="comment-sheet-seal">笺</view>
      <view class="comment-sheet-heading">
        <view class="comment-sheet-title">{{isSharedViewer ? '给馆主留言' : '私藏留言'}}</view>
        <view class="comment-sheet-subtitle">{{isSharedViewer ? '仅你与馆主可见' : '仅你可见 · 来自分享访客'}}</view>
      </view>
      <view class="comment-sheet-close" bindtap="closeComments">×</view>
    </view>
    <view class="comment-sheet-rule"><text></text><view>◇</view><text></text></view>

    <scroll-view class="comment-list" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view wx:if="{{!comments.length}}" class="comment-empty">
        <view class="comment-empty-mark">〝</view>
        <view>{{isSharedViewer ? '还没有留下悄悄话' : '暂时还没有收到留言'}}</view>
      </view>
      <view wx:for="{{comments}}" wx:key="id" class="comment-entry {{isSharedViewer ? 'is-mine' : ''}}">
        <view class="comment-entry-meta">
          <text>{{isSharedViewer ? '我的留言' : (item.author && item.author.displayName ? item.author.displayName : '一位访客')}}</text>
          <text>{{item.displayTime}}</text>
        </view>
        <view class="comment-entry-paper">{{item.content}}</view>
      </view>
    </scroll-view>

    <view wx:if="{{isSharedViewer}}" class="comment-composer">
      <view class="visitor-name-row">
        <text>留言署名</text>
        <input value="{{visitorName}}" maxlength="20" placeholder="输入希望馆主看到的名字" bindinput="updateVisitorName" />
      </view>
      <view class="comment-compose-row">
        <textarea
          class="comment-input"
          value="{{commentDraft}}"
          maxlength="300"
          auto-height="{{false}}"
          placeholder="写下一句只给馆主看的话…"
          placeholder-class="comment-placeholder"
          bindinput="updateCommentDraft"
        ></textarea>
        <button
          class="comment-submit"
          disabled="{{!visitorName || !commentDraft || commentSubmitting}}"
          bindtap="submitComment"
        >{{commentSubmitting ? '送出中' : '送出'}}</button>
      </view>
    </view>
  </view>
  <museum-guide id="museumGuide" bind:action="handleTutorialAction"></museum-guide>
  <view wx:if="{{toast}}" class="toast">{{toast}}</view>
</view>
