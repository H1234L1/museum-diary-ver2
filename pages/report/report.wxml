<view class="report-page" bindtap="handleTutorialPreviewTap">
  <view class="report-nav">
    <view class="back" bindtap="goBack">‹</view>
  </view>

  <view class="report-sheet">
    <view class="corner corner-left"></view>
    <view class="corner corner-right"></view>

    <view class="report-meta">
      <text>LIFE MUSEUM</text>
      <text>{{monthText}}</text>
    </view>

    <view class="museum-emblem">
      <view class="emblem-roof"></view>
      <view class="emblem-columns"><text></text><text></text><text></text></view>
      <view class="emblem-base"></view>
    </view>

    <view class="report-scene" aria-hidden="true">
      <image src="/assets/art/home-hero.jpg" mode="aspectFill"></image>
      <view class="scene-wash"></view>
    </view>

    <view class="report-hero">
      <view class="report-title">我在 {{monthName}} 收藏了</view>
      <view class="report-number"><text>{{monthlyItemCount}}</text><view>件展品</view></view>
      <view class="hero-ornament"><text></text><view class="ornament-diamond">◆</view><text></text></view>
      <view class="report-slogan">每一个瞬间，都是生命的展品。</view>
    </view>

    <view class="overview-heading">
      <text></text><view>{{monthName}}· 馆藏概览</view><text></text>
    </view>

    <view class="report-stats">
      <view class="stat-cell">
        <view class="stat-label"><text class="stat-icon">✎</text>当月入馆字数</view>
        <view class="stat-value">{{monthlyWordCount}}<text>字</text></view>
      </view>
      <view class="stat-cell">
        <view class="stat-label"><text class="stat-icon">◷</text>累计入馆时间</view>
        <view class="stat-value">{{monthlyActiveMinutes}}<text>分钟</text></view>
      </view>
      <view class="stat-cell">
        <view class="stat-label"><text class="stat-icon">▧</text>当月入馆图片</view>
        <view class="stat-value">{{monthlyImageCount}}<text>张</text></view>
      </view>
      <view class="stat-cell">
        <view class="stat-label"><text class="stat-icon">▦</text>当月入馆天数</view>
        <view class="stat-value">{{monthlyVisitDays}}<text>天</text></view>
      </view>
      <view class="stat-cell">
        <view class="stat-label"><text class="stat-icon">馆</text>最爱的展厅</view>
        <view class="stat-value stat-hall">{{favoriteHall}}</view>
      </view>
      <view class="stat-cell">
        <view class="stat-label"><text class="stat-icon">☾</text>最晚离馆时间</view>
        <view class="stat-value">{{latestExitTime}}</view>
      </view>
    </view>

    <view wx:if="{{monthlyAudioMinutes > 0}}" class="voice-footnote">
      本月还收藏了 {{monthlyAudioMinutes}} 分钟声音
    </view>

    <view class="report-footer">
      <view class="brand-cn">人生博物馆</view>
      <view class="brand-en">Life Museum</view>
      <view class="footer-leaves"><text></text><text></text><text></text></view>
    </view>
  </view>

  <button class="share-action" open-type="share" aria-label="分享月报">
    <view class="share-symbol">
      <view class="share-arrow">↗</view>
      <view class="share-box"></view>
    </view>
  </button>
</view>
