.report-page {
  min-height: 100vh;
  padding: calc(52rpx + env(safe-area-inset-top)) 22rpx calc(46rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    repeating-linear-gradient(90deg, rgba(105,78,48,.018) 0, rgba(105,78,48,.018) 1rpx, transparent 1rpx, transparent 10rpx),
    #d8c7ae;
  color: #342c24;
}

.report-nav {
  position: relative;
  z-index: 5;
  height: 72rpx;
  display: flex;
  align-items: center;
}

.back {
  width: 72rpx;
  height: 72rpx;
  color: #51463a;
  font-family: var(--font-numeral, serif);
  font-size: 58rpx;
  font-weight: 400;
  line-height: 63rpx;
  text-align: left;
}

.report-sheet {
  position: relative;
  min-height: 1040rpx;
  padding: 42rpx 38rpx 0;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(159,124,76,.27);
  background:
    linear-gradient(90deg, rgba(255,255,255,.5), transparent 24%, transparent 76%, rgba(205,186,158,.13)),
    repeating-linear-gradient(0deg, rgba(111,81,48,.017) 0, rgba(111,81,48,.017) 1rpx, transparent 1rpx, transparent 9rpx),
    #f7f2e9;
  box-shadow: 0 24rpx 66rpx rgba(65,45,25,.22), inset 0 2rpx 0 rgba(255,255,255,.8);
}

.corner {
  position: absolute;
  top: -1rpx;
  width: 36rpx;
  height: 36rpx;
  background: #d8c7ae;
  z-index: 4;
}

.corner::after {
  content: '';
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border-top: 1rpx solid rgba(159,124,76,.27);
  border-radius: 0 0 0 36rpx;
}

.corner-left { left: -1rpx; }
.corner-right { right: -1rpx; transform: scaleX(-1); }

.report-meta {
  position: relative;
  z-index: 3;
  display: flex;
  justify-content: space-between;
  color: #62584d;
  font-family: var(--font-numeral, serif);
  font-size: 19rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
}

.museum-emblem {
  position: relative;
  z-index: 3;
  width: 56rpx;
  height: 50rpx;
  margin: 14rpx auto 0;
  color: #aa824b;
}

.emblem-roof {
  width: 0;
  height: 0;
  margin: 0 auto 4rpx;
  border-left: 27rpx solid transparent;
  border-right: 27rpx solid transparent;
  border-bottom: 15rpx solid #aa824b;
}

.emblem-columns { height: 25rpx; display: flex; justify-content: space-around; border-top: 4rpx solid #aa824b; }
.emblem-columns text { width: 5rpx; height: 23rpx; background: #aa824b; }
.emblem-base { height: 5rpx; border-top: 3rpx solid #aa824b; border-bottom: 3rpx solid #aa824b; }

.report-scene {
  position: absolute;
  z-index: 1;
  top: 0;
  right: 0;
  width: 42%;
  height: 610rpx;
  overflow: hidden;
  border-radius: 230rpx 0 0 0;
  opacity: .88;
}

.report-scene image { width: 100%; height: 100%; display: block; }
.scene-wash {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, #f7f2e9 0, rgba(247,242,233,.58) 17%, rgba(210,188,155,.05) 60%), linear-gradient(0deg, #f7f2e9 0, transparent 22%);
}

.report-hero {
  position: relative;
  z-index: 2;
  width: 72%;
  min-height: 490rpx;
  padding-top: 105rpx;
  box-sizing: border-box;
}

.report-title { font-size: 40rpx; font-weight: 500; letter-spacing: 4rpx; white-space: nowrap; }
.report-number { margin-top: 20rpx; display: flex; align-items: baseline; gap: 18rpx; white-space: nowrap; }
.report-number > text { color: #a87a39; font-family: var(--font-numeral, serif); font-size: 102rpx; font-weight: 400; line-height: .95; }
.report-number > view { font-size: 43rpx; font-weight: 500; letter-spacing: 4rpx; }

.hero-ornament { width: 360rpx; margin: 34rpx 0 28rpx; display: flex; align-items: center; gap: 19rpx; color: #ae8650; }
.hero-ornament text { height: 1rpx; flex: 1; background: rgba(174,134,80,.65); }
.ornament-diamond { font-size: 18rpx; }
.report-slogan { font-size: 23rpx; letter-spacing: 2rpx; }

.overview-heading {
  position: relative;
  z-index: 3;
  margin: 8rpx 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #a77d43;
}

.overview-heading text { height: 1rpx; flex: 1; background: rgba(176,139,87,.38); }
.overview-heading view { font-size: 25rpx; font-weight: 500; letter-spacing: 3rpx; white-space: nowrap; }

.report-stats {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding-bottom: 34rpx;
}

.stat-cell {
  min-height: 150rpx;
  padding: 18rpx 10rpx 16rpx;
  box-sizing: border-box;
  text-align: center;
  border-right: 1rpx solid rgba(177,142,94,.3);
}

.stat-cell:nth-child(3n) { border-right: 0; }
.stat-cell:nth-child(n+4) { border-top: 1rpx solid rgba(177,142,94,.2); }
.stat-label { min-height: 46rpx; color: #5f5347; font-size: 18rpx; line-height: 1.35; }
.stat-icon { margin-right: 7rpx; color: #ad834a; font-family: var(--font-numeral, serif); font-size: 24rpx; }
.stat-value { margin-top: 12rpx; color: #302821; font-family: var(--font-numeral, serif); font-size: 39rpx; font-weight: 400; line-height: 1.1; }
.stat-value > text { margin-left: 6rpx; color: #64594e; font-size: 17rpx; }
.stat-hall { overflow: hidden; font-family: var(--font-display, serif); font-size: 28rpx; white-space: nowrap; text-overflow: ellipsis; }

.voice-footnote {
  position: relative;
  z-index: 3;
  margin: -12rpx auto 24rpx;
  color: #8e7658;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

.report-footer {
  position: relative;
  z-index: 3;
  min-height: 150rpx;
  margin: 0 -38rpx;
  padding: 30rpx 44rpx;
  box-sizing: border-box;
  background: linear-gradient(110deg, #d3c09e, #c7b18c);
}

.brand-cn { font-size: 28rpx; font-weight: 500; letter-spacing: 3rpx; }
.brand-en { margin-top: 5rpx; font-family: var(--font-numeral, serif); font-size: 18rpx; font-style: italic; }
.footer-leaves { position: absolute; right: 34rpx; bottom: 17rpx; width: 120rpx; height: 75rpx; transform: rotate(-24deg); border-bottom: 3rpx solid rgba(110,87,55,.17); }
.footer-leaves text { position: absolute; width: 43rpx; height: 22rpx; border-radius: 100% 0 100% 0; background: rgba(110,87,55,.12); }
.footer-leaves text:nth-child(1) { left: 18rpx; bottom: 8rpx; transform: rotate(24deg); }
.footer-leaves text:nth-child(2) { left: 50rpx; bottom: 28rpx; transform: rotate(16deg); }
.footer-leaves text:nth-child(3) { left: 84rpx; bottom: 47rpx; transform: rotate(8deg); }

.share-action,
button.share-action {
  position: fixed;
  right: 30rpx;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  z-index: 20;
  width: 88rpx !important;
  min-width: 88rpx !important;
  max-width: 88rpx !important;
  height: 88rpx !important;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  display: flex;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(104,80,50,.32);
  border-radius: 999rpx;
  background: rgba(246,238,226,.78);
  box-shadow: 0 10rpx 26rpx rgba(59,42,24,.14), inset 0 2rpx 0 rgba(255,255,255,.62);
  line-height: 1;
}

.share-action::after { border: 0; }
.share-symbol { position: relative; width: 40rpx; height: 40rpx; }
.share-box { position: absolute; left: 4rpx; bottom: 2rpx; width: 27rpx; height: 24rpx; border: 2rpx solid #5b4d3f; border-top: 0; }
.share-arrow { position: absolute; z-index: 2; top: -10rpx; right: 0; color: #5b4d3f; font-family: var(--font-numeral, serif); font-size: 38rpx; line-height: 1; }
