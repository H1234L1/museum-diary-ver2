page {
  min-height: 100%;
  background: #eee8dd;
}

.report-page {
  min-height: 100vh;
  padding: calc(25rpx + env(safe-area-inset-top)) 28rpx calc(55rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 14% 8%, rgba(255,255,255,.72), transparent 25%),
    repeating-linear-gradient(90deg, rgba(111,83,50,.016) 0, rgba(111,83,50,.016) 1rpx, transparent 1rpx, transparent 11rpx),
    #eee8dd;
  color: #342e28;
}

.report-nav {
  position: relative;
  height: 92rpx;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.report-nav-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  color: #413a32;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 5rpx;
}

.nav-button,
button.nav-button {
  position: relative;
  width: 76rpx;
  min-width: 76rpx;
  height: 76rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 1rpx solid rgba(88,70,50,.10);
  border-radius: 50%;
  background: rgba(255,253,248,.82);
  box-shadow: 0 7rpx 18rpx rgba(63,48,32,.09), inset 0 1rpx rgba(255,255,255,.9);
}

.nav-button::after { border: 0; }
.back-chevron {
  position: absolute;
  left: 31rpx;
  top: 25rpx;
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #302d29;
  border-bottom: 4rpx solid #302d29;
  transform: rotate(45deg);
}
.back-chevron::after {
  content: '';
  position: absolute;
  left: -3rpx;
  top: 16rpx;
  width: 30rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #302d29;
  transform: rotate(-45deg);
  transform-origin: left center;
}
.share-arrow {
  position: absolute;
  left: 34rpx;
  top: 18rpx;
  width: 15rpx;
  height: 20rpx;
  border-top: 3rpx solid #302d29;
  border-left: 3rpx solid #302d29;
  transform: rotate(45deg);
}
.share-arrow::after {
  content: '';
  position: absolute;
  left: -2rpx;
  top: -2rpx;
  width: 25rpx;
  height: 3rpx;
  background: #302d29;
  transform: rotate(-45deg);
  transform-origin: left center;
}
.share-tray {
  position: absolute;
  left: 23rpx;
  bottom: 17rpx;
  width: 29rpx;
  height: 24rpx;
  border: 3rpx solid #302d29;
  border-top: 0;
  border-radius: 2rpx;
}

.report-poster {
  --poster-ink: #fffdf7;
  --poster-muted: rgba(255,253,247,.78);
  --poster-rule: rgba(255,253,247,.42);
  --poster-panel: rgba(34,31,27,.31);
  position: relative;
  min-height: 1140rpx;
  overflow: hidden;
  box-sizing: border-box;
  border-radius: 27rpx;
  color: var(--poster-ink);
  background: #77705f;
  box-shadow: 0 25rpx 60rpx rgba(55,42,29,.24), 0 2rpx 5rpx rgba(55,42,29,.18);
  isolation: isolate;
}

.poster-background,
.poster-blur,
.poster-overlay,
.poster-vignette,
.poster-grain {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.poster-background { z-index: 0; display: block; transform: scale(1.02); }
.poster-blur { z-index: 1; backdrop-filter: blur(1.5rpx); -webkit-backdrop-filter: blur(1.5rpx); }
.poster-overlay { z-index: 2; transition: background .25s ease; }
.poster-vignette {
  z-index: 3;
  background:
    linear-gradient(180deg, rgba(18,18,16,.48), transparent 22%, transparent 69%, rgba(21,20,18,.63)),
    linear-gradient(90deg, rgba(20,19,17,.18), transparent 18%, transparent 82%, rgba(20,19,17,.16));
}
.poster-grain {
  z-index: 4;
  opacity: .15;
  background-image:
    repeating-linear-gradient(27deg, rgba(255,255,255,.10) 0, rgba(255,255,255,.10) 1rpx, transparent 1rpx, transparent 5rpx),
    repeating-linear-gradient(117deg, rgba(0,0,0,.07) 0, rgba(0,0,0,.07) 1rpx, transparent 1rpx, transparent 7rpx);
  mix-blend-mode: soft-light;
}

.theme-olive .poster-overlay { background: rgba(79,72,48,.39); }
.theme-amber .poster-overlay { background: rgba(132,75,21,.34); }
.theme-ocean .poster-overlay { background: rgba(40,78,92,.37); }
.theme-rose .poster-overlay { background: rgba(112,65,56,.37); }
.theme-ink .poster-overlay { background: rgba(24,27,31,.54); }

.font-museum { font-family: var(--font-display), serif; }
.font-classic { font-family: "Baskerville", "Iowan Old Style", "Times New Roman", var(--font-display), serif; }
.font-handwriting { font-family: "FZKai-Z03", "STKaiti", "KaiTi", var(--font-display), serif; }

.poster-topline {
  position: relative;
  z-index: 6;
  height: 76rpx;
  padding: 28rpx 27rpx 0;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: start;
  box-sizing: border-box;
  color: var(--poster-muted);
  font-family: "Baskerville", "Times New Roman", serif;
  font-size: 15rpx;
  font-weight: 500;
  letter-spacing: 1.5rpx;
}
.poster-brand { justify-self: start; white-space: nowrap; }
.brand-ring { margin-right: 5rpx; font-size: 20rpx; }
.poster-year { justify-self: center; color: var(--poster-ink); font-size: 20rpx; letter-spacing: 2rpx; }
.poster-edition { justify-self: end; font-size: 12rpx; font-style: italic; }

.calendar-composition {
  position: relative;
  z-index: 6;
  width: 76%;
  margin: 82rpx auto 0;
  text-align: center;
}
.month-script {
  overflow: hidden;
  color: var(--poster-ink);
  font-family: "Snell Roundhand", "Segoe Script", "Brush Script MT", "Baskerville", cursive;
  font-size: 68rpx;
  font-style: italic;
  font-weight: 500;
  letter-spacing: 4rpx;
  line-height: 1.15;
  text-shadow: 0 4rpx 13rpx rgba(18,16,14,.28);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.font-handwriting .month-script { font-family: "FZKai-Z03", "STKaiti", "KaiTi", cursive; font-style: normal; letter-spacing: 7rpx; }
.month-rule { width: 44rpx; height: 1rpx; margin: 16rpx auto 25rpx; background: var(--poster-rule); }
.calendar-weekdays,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}
.calendar-weekdays { margin-bottom: 12rpx; }
.weekday {
  color: var(--poster-muted);
  font-family: "Baskerville", "Times New Roman", serif;
  font-size: 14rpx;
  font-style: italic;
  font-weight: 500;
  text-align: center;
}
.calendar-grid { row-gap: 8rpx; }
.calendar-day {
  position: relative;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--poster-ink);
  font-family: "Baskerville", "Times New Roman", serif;
  font-size: 18rpx;
  font-weight: 500;
  text-shadow: 0 2rpx 5rpx rgba(17,15,12,.32);
}
.calendar-day.empty { visibility: hidden; }
.calendar-day.recorded::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid rgba(255,255,250,.92);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 2rpx 7rpx rgba(22,19,15,.18);
}
.calendar-day.recorded::after {
  content: '';
  position: absolute;
  right: 8rpx;
  bottom: 4rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: rgba(255,255,248,.82);
}

.monthly-story {
  position: relative;
  z-index: 6;
  width: calc(100% - 58rpx);
  margin: 78rpx auto 0;
  padding: 27rpx 24rpx 22rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255,252,244,.24);
  border-radius: 18rpx;
  background: var(--poster-panel);
  box-shadow: inset 0 1rpx rgba(255,255,255,.16), 0 14rpx 30rpx rgba(20,17,14,.12);
  backdrop-filter: blur(15rpx);
  -webkit-backdrop-filter: blur(15rpx);
}
.story-kicker {
  color: var(--poster-muted);
  font-size: 16rpx;
  letter-spacing: 5rpx;
  text-align: center;
}
.story-total {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  color: var(--poster-ink);
  font-size: 23rpx;
  letter-spacing: 2rpx;
}
.story-number {
  font-family: "Baskerville", "Times New Roman", serif;
  font-size: 58rpx;
  font-weight: 400;
  line-height: 1;
}
.story-rule { width: 62%; margin: 15rpx auto 13rpx; display: flex; align-items: center; gap: 11rpx; }
.story-rule text { height: 1rpx; flex: 1; background: var(--poster-rule); }
.story-rule view { color: var(--poster-muted); font-size: 9rpx; }
.report-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}
.stat-cell {
  min-height: 88rpx;
  padding: 10rpx 7rpx 8rpx;
  box-sizing: border-box;
  border-right: 1rpx solid rgba(255,252,244,.17);
  text-align: center;
}
.stat-cell:nth-child(3n) { border-right: 0; }
.stat-cell:nth-child(n+4) { border-top: 1rpx solid rgba(255,252,244,.14); }
.stat-label { color: var(--poster-muted); font-size: 14rpx; letter-spacing: 1rpx; }
.stat-value {
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--poster-ink);
  font-family: "Baskerville", "Times New Roman", serif;
  font-size: 28rpx;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.stat-value text { margin-left: 4rpx; color: var(--poster-muted); font-family: var(--font-display); font-size: 12rpx; }
.stat-hall { font-family: inherit; font-size: 21rpx; }
.voice-footnote { margin-top: 13rpx; color: var(--poster-muted); font-size: 13rpx; letter-spacing: 2rpx; text-align: center; }

.poster-footer {
  position: absolute;
  left: 29rpx;
  right: 29rpx;
  bottom: 29rpx;
  z-index: 6;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: end;
  color: var(--poster-muted);
  font-size: 15rpx;
  letter-spacing: 2rpx;
}
.poster-footer text { font-family: "Baskerville", "Times New Roman", serif; font-size: 11rpx; font-style: italic; letter-spacing: 1rpx; }
.poster-footer view:last-child { justify-self: end; font-family: "Baskerville", "Times New Roman", serif; }
.change-photo-hint {
  position: absolute;
  left: 50%;
  bottom: 84rpx;
  z-index: 7;
  padding: 9rpx 18rpx;
  border: 1rpx solid rgba(255,255,250,.20);
  border-radius: 24rpx;
  background: rgba(24,22,19,.20);
  color: rgba(255,255,250,.70);
  font-size: 12rpx;
  letter-spacing: 2rpx;
  transform: translateX(-50%);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

.design-trigger {
  position: fixed;
  right: 19rpx;
  bottom: calc(42rpx + env(safe-area-inset-bottom));
  z-index: 30;
  width: 86rpx;
  height: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(106,83,57,.25);
  border-radius: 50%;
  background: rgba(252,248,240,.88);
  box-shadow: 0 12rpx 30rpx rgba(58,43,28,.18), inset 0 1rpx rgba(255,255,255,.9);
  color: #5c4b39;
  font-size: 15rpx;
  letter-spacing: 2rpx;
  backdrop-filter: blur(13rpx);
  -webkit-backdrop-filter: blur(13rpx);
}
.sliders-icon { width: 34rpx; height: 28rpx; margin-bottom: 3rpx; display: flex; flex-direction: column; justify-content: space-between; }
.sliders-icon text { position: relative; width: 34rpx; height: 2rpx; background: #6b5944; }
.sliders-icon text::after { content: ''; position: absolute; top: -4rpx; width: 9rpx; height: 9rpx; border: 2rpx solid #6b5944; border-radius: 50%; background: #faf5ec; }
.sliders-icon text:nth-child(1)::after { left: 6rpx; }
.sliders-icon text:nth-child(2)::after { right: 4rpx; }
.sliders-icon text:nth-child(3)::after { left: 13rpx; }

.designer-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(34,29,24,.43);
  backdrop-filter: blur(5rpx);
  -webkit-backdrop-filter: blur(5rpx);
}
.designer-sheet {
  position: relative;
  width: 100%;
  min-height: 470rpx;
  max-height: 72vh;
  padding: 17rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  box-sizing: border-box;
  border-radius: 34rpx 34rpx 0 0;
  background:
    repeating-linear-gradient(90deg, rgba(105,78,48,.014) 0, rgba(105,78,48,.014) 1rpx, transparent 1rpx, transparent 9rpx),
    #f4eee4;
  box-shadow: 0 -24rpx 60rpx rgba(39,29,20,.22);
}
.sheet-handle { width: 70rpx; height: 7rpx; margin: 0 auto 22rpx; border-radius: 5rpx; background: rgba(91,72,51,.25); }
.designer-heading { display: flex; align-items: flex-start; justify-content: space-between; }
.designer-kicker { color: #a18461; font-family: "Baskerville", "Times New Roman", serif; font-size: 15rpx; letter-spacing: 3rpx; }
.designer-title { margin-top: 6rpx; color: #3a322a; font-size: 34rpx; font-weight: 500; letter-spacing: 3rpx; }
.designer-done { padding: 12rpx 22rpx; border-radius: 25rpx; background: #2f2d2b; color: #fffdf8; font-size: 20rpx; letter-spacing: 2rpx; }
.designer-tabs { height: 67rpx; margin-top: 25rpx; padding: 5rpx; display: flex; box-sizing: border-box; border: 1rpx solid rgba(112,86,56,.14); border-radius: 35rpx; background: rgba(223,211,194,.45); }
.designer-tab { height: 55rpx; flex: 1; border-radius: 28rpx; color: #806e5b; font-size: 22rpx; line-height: 55rpx; letter-spacing: 3rpx; text-align: center; }
.designer-tab.active { background: #2e2d2b; color: #fffdf8; box-shadow: 0 5rpx 12rpx rgba(53,40,27,.15); }
.designer-content { min-height: 235rpx; padding-top: 25rpx; }
.content-note { margin-bottom: 20rpx; color: #8d7b68; font-size: 19rpx; letter-spacing: 1rpx; }
.photo-scroll { width: calc(100% + 30rpx); }
.photo-options { display: flex; gap: 16rpx; padding: 2rpx 30rpx 7rpx 1rpx; }
.photo-option { position: relative; flex: none; width: 142rpx; height: 178rpx; overflow: hidden; box-sizing: border-box; border: 3rpx solid transparent; border-radius: 15rpx; background: #cbbda9; box-shadow: 0 7rpx 16rpx rgba(55,41,27,.11); }
.photo-option.selected { border-color: #a47a44; box-shadow: 0 0 0 3rpx rgba(164,122,68,.14), 0 8rpx 18rpx rgba(55,41,27,.16); }
.photo-option image { width: 100%; height: 100%; display: block; }
.photo-option-shade { position: absolute; inset: 45% 0 0; background: linear-gradient(transparent, rgba(24,20,16,.62)); }
.photo-option-title { position: absolute; left: 10rpx; right: 10rpx; bottom: 9rpx; overflow: hidden; color: #fffdf8; font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }
.option-check { position: absolute; right: 8rpx; top: 8rpx; width: 31rpx; height: 31rpx; border-radius: 50%; background: rgba(255,250,240,.92); color: #795a32; font-size: 19rpx; line-height: 31rpx; text-align: center; }
.empty-photo-library { padding: 55rpx 20rpx; border: 1rpx dashed rgba(121,91,57,.28); border-radius: 16rpx; color: #8b7964; font-size: 21rpx; text-align: center; }
.theme-options { display: flex; justify-content: space-between; gap: 13rpx; }
.theme-option { flex: 1; color: #796956; font-size: 16rpx; letter-spacing: 1rpx; text-align: center; }
.theme-swatch { width: 77rpx; height: 77rpx; margin: 0 auto 12rpx; border: 5rpx solid #f4eee4; border-radius: 50%; box-shadow: 0 0 0 1rpx rgba(79,61,42,.16), 0 7rpx 14rpx rgba(54,40,26,.11); color: white; font-size: 28rpx; line-height: 77rpx; text-align: center; }
.theme-option.selected .theme-swatch { box-shadow: 0 0 0 4rpx #3b342d, 0 8rpx 16rpx rgba(54,40,26,.16); }
.font-option { min-height: 78rpx; margin-bottom: 12rpx; padding: 12rpx 17rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; border: 1rpx solid rgba(118,91,60,.16); border-radius: 13rpx; background: rgba(255,252,246,.45); color: #473d33; }
.font-option.selected { border-color: rgba(145,103,54,.55); background: rgba(226,210,186,.48); box-shadow: inset 4rpx 0 #9d743f; }
.font-option text { color: #806c55; font-size: 16rpx; letter-spacing: 2rpx; }
.font-option view view { margin-top: 4rpx; font-size: 25rpx; }
.font-check { width: 42rpx; color: #966d38; font-size: 27rpx; text-align: center; }
.saving-note { position: absolute; right: 32rpx; bottom: calc(10rpx + env(safe-area-inset-bottom)); color: #9a8873; font-size: 16rpx; }


/* Layout 1: blurred calendar above, archive data below */
.layout-calendar .calendar-composition {
  width: 82%;
  margin-top: 48rpx;
  padding: 28rpx 25rpx 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255,253,247,.18);
  border-radius: 24rpx;
  background: rgba(32,30,27,.18);
  box-shadow: inset 0 1rpx rgba(255,255,255,.12), 0 14rpx 30rpx rgba(20,18,15,.09);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}
.layout-calendar .monthly-story { margin-top: 42rpx; }

/* Layout 2: month stamp with a vertical archive ledger */
.layout-postcard { background: #776b4d; }
.layout-postcard .poster-background { opacity: .16; filter: blur(25rpx) saturate(.72); transform: scale(1.14); }
.layout-postcard .poster-blur { backdrop-filter: blur(18rpx); -webkit-backdrop-filter: blur(18rpx); }
.layout-postcard.theme-olive .poster-overlay { background: rgba(101,89,57,.88); }
.layout-postcard.theme-amber .poster-overlay { background: rgba(133,86,34,.88); }
.layout-postcard.theme-ocean .poster-overlay { background: rgba(55,86,94,.89); }
.layout-postcard.theme-rose .poster-overlay { background: rgba(120,78,69,.89); }
.layout-postcard.theme-ink .poster-overlay { background: rgba(40,42,44,.93); }
.layout-postcard .poster-vignette { background: linear-gradient(180deg,rgba(21,19,16,.16),transparent 30%,rgba(21,19,16,.22)); }
.postcard-composition { position: relative; z-index: 6; padding: 115rpx 29rpx 0; }
.postcard-caption { color: rgba(255,252,244,.52); font-family: "Baskerville","Times New Roman",serif; font-size: 13rpx; letter-spacing: 5rpx; text-align: center; }
.postcard-body { margin-top: 52rpx; display: flex; align-items: center; justify-content: center; gap: 27rpx; }
.postcard-stamp { position: relative; width: 61%; height: 610rpx; padding: 13rpx; box-sizing: border-box; background: #f5f0e7; filter: drop-shadow(0 18rpx 27rpx rgba(25,21,17,.25)); }
.stamp-edge { position: absolute; inset: -7rpx; z-index: -1; background: radial-gradient(circle at 7rpx 7rpx,transparent 6rpx,#f5f0e7 6.7rpx) -7rpx -7rpx / 22rpx 22rpx; }
.postcard-stamp image { width: 100%; height: 72%; display: block; }
.stamp-ticket { height: 28%; padding: 19rpx 15rpx 10rpx; box-sizing: border-box; color: #62583e; background: #f5f0e7; }
.stamp-month { overflow: hidden; font-family: "Snell Roundhand","Segoe Script","Brush Script MT",cursive; font-size: 45rpx; font-style: italic; line-height: 1.1; text-overflow: ellipsis; white-space: nowrap; }
.font-handwriting .stamp-month { font-family: "FZKai-Z03","STKaiti","KaiTi",cursive; font-style: normal; }
.stamp-date { margin-top: 19rpx; font-family: "Baskerville","Times New Roman",serif; font-size: 16rpx; letter-spacing: 2rpx; }
.stamp-year { position: absolute; right: 25rpx; bottom: 25rpx; font-family: "Baskerville","Times New Roman",serif; font-size: 25rpx; font-weight: 600; }
.postcard-data { width: 31%; min-height: 590rpx; padding-left: 21rpx; display: flex; flex-direction: column; justify-content: center; box-sizing: border-box; border-left: 1rpx solid rgba(255,252,244,.30); }
.postcard-total text { font-family: "Baskerville","Times New Roman",serif; font-size: 61rpx; line-height: 1; }
.postcard-total view { margin-top: 3rpx; color: var(--poster-muted); font-size: 17rpx; letter-spacing: 2rpx; }
.postcard-data-rule { width: 34rpx; height: 1rpx; margin: 20rpx 0 13rpx; background: rgba(255,252,244,.42); }
.postcard-stat { padding: 10rpx 0; border-bottom: 1rpx solid rgba(255,252,244,.13); }
.postcard-stat text { color: var(--poster-muted); font-size: 12rpx; letter-spacing: 1rpx; }
.postcard-stat view { margin-top: 3rpx; overflow: hidden; font-family: "Baskerville","Times New Roman",var(--font-display),serif; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.postcard-voice { margin-top: 12rpx; color: var(--poster-muted); font-size: 11rpx; }
.postcard-mark { margin-top: 65rpx; color: rgba(255,252,244,.28); font-family: "Baskerville","Times New Roman",serif; font-size: 12rpx; letter-spacing: 5rpx; text-align: center; }
.layout-postcard .change-photo-hint { bottom: 95rpx; }

/* Layout picker */
.layout-options { display: flex; gap: 18rpx; }
.layout-option { position: relative; flex: 1; padding: 12rpx 12rpx 15rpx; box-sizing: border-box; border: 1rpx solid rgba(118,91,60,.16); border-radius: 16rpx; background: rgba(255,252,246,.46); }
.layout-option.selected { border-color: rgba(145,103,54,.62); background: rgba(226,210,186,.50); box-shadow: inset 0 0 0 2rpx rgba(157,116,63,.11); }
.layout-mini { position: relative; height: 146rpx; overflow: hidden; border-radius: 10rpx; background: #796c50; box-shadow: inset 0 0 12rpx rgba(46,34,22,.14); }
.layout-mini .mini-photo { position: absolute; inset: 0; opacity: .52; background: linear-gradient(145deg,#c99255,#5e8997 55%,#504a3b); }
.mini-calendar,.mini-data { position: absolute; z-index: 2; }
.mini-calendar { left: 17%; right: 17%; top: 13rpx; height: 66rpx; padding: 9rpx; display: grid; grid-template-columns: repeat(3,1fr); gap: 5rpx; box-sizing: border-box; border-radius: 7rpx; background: rgba(255,255,250,.16); backdrop-filter: blur(5rpx); }
.mini-calendar text { width: 6rpx; height: 6rpx; align-self: center; justify-self: center; border-radius: 50%; background: rgba(255,255,250,.76); }
.mini-data { left: 13%; right: 13%; bottom: 13rpx; height: 40rpx; display: flex; align-items: center; justify-content: space-around; border-radius: 6rpx; background: rgba(36,31,25,.34); }
.mini-data text { width: 18%; height: 4rpx; background: rgba(255,255,250,.68); }
.mini-postcard .mini-calendar { left: 13%; right: 42%; top: 22rpx; bottom: 22rpx; height: auto; display: block; border: 5rpx solid #f4eee4; border-radius: 0; background: linear-gradient(180deg,rgba(101,152,166,.9) 0 65%,#f4eee4 65%); }
.mini-postcard .mini-calendar text { display: none; }
.mini-postcard .mini-data { left: 68%; right: 10%; top: 26rpx; bottom: 26rpx; height: auto; flex-direction: column; background: transparent; border-left: 1rpx solid rgba(255,255,250,.45); }
.mini-postcard .mini-data text { width: 75%; height: 3rpx; }
.layout-option-name { margin-top: 12rpx; color: #4d4135; font-size: 22rpx; font-weight: 500; letter-spacing: 2rpx; }
.layout-option-note { margin-top: 5rpx; color: #92806c; font-size: 15rpx; }
.layout-check { position: absolute; right: 20rpx; bottom: 18rpx; color: #916737; font-size: 25rpx; }


/* Calendar layout correction: type floats on the photo; data lives in a solid sampled-color block. */
.layout-calendar .poster-background,
.layout-calendar .poster-overlay,
.layout-calendar .poster-vignette,
.layout-calendar .poster-grain {
  height: 690rpx;
  bottom: auto;
}
.layout-calendar .poster-background { filter: blur(3rpx); transform: scale(1.03); transform-origin: center top; }
.layout-calendar .poster-blur { display: none; }
.layout-calendar .poster-vignette { background: linear-gradient(180deg,rgba(18,18,16,.42),transparent 24%,rgba(18,18,16,.30)); }
.layout-calendar .calendar-composition {
  width: 76%;
  margin-top: 58rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}
.layout-calendar .monthly-story {
  position: absolute;
  left: 0;
  right: 0;
  top: 690rpx;
  bottom: 0;
  width: 100%;
  margin: 0;
  padding: 35rpx 49rpx 91rpx;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}
.layout-calendar .monthly-story::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1rpx;
  background: rgba(255,255,255,.18);
}
.layout-calendar .change-photo-hint { top: 626rpx; bottom: auto; }
.layout-calendar .poster-footer { color: var(--poster-muted); }
.monthly-story.tone-light {
  --poster-ink: #302b25;
  --poster-muted: rgba(48,43,37,.72);
  --poster-rule: rgba(48,43,37,.34);
}
.monthly-story.tone-light .stat-cell { border-color: rgba(48,43,37,.16); }

@media (max-height: 720px) {
  .report-poster { min-height: 1030rpx; }
  .calendar-composition { margin-top: 52rpx; }
  .monthly-story { margin-top: 48rpx; }
}
