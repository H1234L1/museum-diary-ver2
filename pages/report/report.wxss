.report-page {
  min-height: 100vh;
  padding: calc(30rpx + env(safe-area-inset-top)) 24rpx 50rpx;
  box-sizing: border-box;
  background: #d8c8b4;
}
.report-nav {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
}
.back {
  width: 90rpx;
  font-size: 58rpx;
}
.share-top {
  width: 90rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #4e4439;
  font-size: 27rpx;
  line-height: 70rpx;
}
.share-top::after {
  border: 0;
}
.report-sheet {
  position: relative;
  padding: 38rpx 42rpx 0;
  overflow: hidden;
  border-radius: 8rpx;
  background: linear-gradient(135deg,#faf6ef,#eee4d6);
  box-shadow: 0 24rpx 70rpx rgba(59,39,19,.24);
}
.report-meta {
  display: flex;
  justify-content: space-between;
  color: #554d43;
  font-family: var(--font-numeral);
  font-weight: 400;
  font-size: 21rpx;
  letter-spacing: 2rpx;
}
.museum-mark {
  width: 60rpx;
  height: 55rpx;
  margin: 25rpx auto 85rpx;
  line-height: 55rpx;
  text-align: center;
  border: 3rpx double #aa834f;
  color: #9a713c;
}
.report-title {
  font-size: 49rpx;
  letter-spacing: 5rpx;
}
.report-number {
  margin-top: 12rpx;
  font-size: 48rpx;
  letter-spacing: 5rpx;
}
.report-number text {
  margin-right: 20rpx;
  color: #9e7338;
  font-family: var(--font-numeral);
  font-weight: 400;
  font-size: 96rpx;
}
.ornament {
  margin: 12rpx 0 20rpx;
  color: #b08a55;
}
.report-slogan {
  color: #5f5549;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
.moment-card {
  width: 70%;
  margin: 52rpx 0 40rpx;
  padding: 25rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(155,124,84,.34);
  background: rgba(252,248,241,.72);
  box-shadow: 0 12rpx 25rpx rgba(74,50,26,.14);
}
.moment-label {
  margin-bottom: 20rpx;
  text-align: center;
  font-size: 25rpx;
  letter-spacing: 3rpx;
}
.moment-card image {
  width: 100%;
  height: 230rpx;
  display: block;
  border-radius: 12rpx;
}
.moment-empty,
.selected-sentence {
  min-height: 230rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #766653;
  border: 1rpx dashed rgba(145,112,70,.45);
  border-radius: 12rpx;
  text-align: center;
}
.moment-empty {
  flex-direction: column;
  font-size: 22rpx;
}
.moment-empty-mark {
  margin-bottom: 10rpx;
  color: #9a713c;
  font-size: 52rpx;
  line-height: 1;
}
.selected-sentence {
  padding: 30rpx;
  color: #514334;
  font-size: 29rpx;
  line-height: 1.8;
}
.moment-date {
  margin-top: 10rpx;
  color: #776956;
  font-size: 20rpx;
}
.selector-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(37,27,17,.45);
}
.selector-sheet {
  width: 100%;
  max-height: 74vh;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 30rpx 30rpx 0 0;
  background: #f7f0e6;
}
.selector-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx 22rpx;
}
.selector-title {
  font-size: 32rpx;
  font-weight: 500;
}
.selector-close {
  width: 52rpx;
  height: 52rpx;
  color: #8b755d;
  font-size: 44rpx;
  line-height: 48rpx;
  text-align: center;
}
.selector-list {
  max-height: 54vh;
}
.selector-option {
  margin-bottom: 16rpx;
  padding: 18rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border: 1rpx solid rgba(157,125,82,.27);
  border-radius: 16rpx;
  background: rgba(255,252,246,.8);
}
.selector-option image {
  width: 108rpx;
  height: 108rpx;
  flex: 0 0 108rpx;
  border-radius: 10rpx;
}
.selector-copy {
  min-width: 0;
  flex: 1;
  color: #514334;
  font-size: 26rpx;
  line-height: 1.55;
}
.selector-copy text {
  display: block;
  margin-top: 8rpx;
  color: #917d65;
  font-size: 20rpx;
}
.selector-sentence {
  font-size: 28rpx;
}
.report-stats {
  margin: 0 -42rpx;
  padding: 24rpx 20rpx;
  display: flex;
  justify-content: space-around;
  background: rgba(250,247,241,.84);
}
.report-stats view {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #d2c0a7;
}
.report-stats view:last-child {
  border: 0;
}
.report-stats text {
  margin: 0 3rpx;
  font-size: 20rpx;
}
.report-stat-label {
  display: block;
  margin-bottom: 8rpx !important;
}
.report-stat-number {
  font-family: var(--font-numeral);
  font-weight: 400;
  font-size: 44rpx !important;
}
.report-footer {
  margin: 0 -42rpx;
  padding: 28rpx 45rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #4e4438;
  background: #c5b39a;
  font-size: 29rpx;
}
.english {
  display: block;
  margin-top: 7rpx;
  font-family: var(--font-numeral);
  font-weight: 400;
  font-size: 20rpx;
  font-style: italic;
}
.qr-demo {
  width: 68rpx;
  height: 68rpx;
  border: 7rpx dotted #4e4438;
  border-radius: 50%;
  line-height: 68rpx;
  text-align: center;
}
