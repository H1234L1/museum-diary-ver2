.summary-page {
  height: 100vh;
  padding: calc(70rpx + env(safe-area-inset-top)) 42rpx 120rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: linear-gradient(145deg,#f8f4ee,#ebe2d7);
}

.page-title {
  flex: none;
  margin-bottom: 34rpx;
  font-size: 58rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
}

.report-sections {
  min-height: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.report-panel {
  min-height: 0;
  flex: 1;
  padding: 34rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(127,95,56,.28);
  border-radius: 20rpx;
  background:
    repeating-linear-gradient(0deg,rgba(107,78,45,.018) 0,rgba(107,78,45,.018) 1rpx,transparent 1rpx,transparent 10rpx),
    rgba(249,243,233,.88);
  box-shadow: 0 14rpx 35rpx rgba(76,53,29,.10), inset 0 2rpx 0 rgba(255,255,255,.72);
}

.current-panel {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.panel-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.panel-kicker {
  margin-bottom: 12rpx;
  color: #9b815f;
  font-family: var(--font-numeral);
  font-size: 19rpx;
  font-weight: 400;
  letter-spacing: 3rpx;
}

.panel-title {
  color: #33291f;
  font-size: 38rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
}

.month-mark {
  color: #8c6738;
  font-family: var(--font-numeral);
  font-size: 66rpx;
  font-weight: 400;
  line-height: 1;
}

.month-mark text {
  margin-left: 5rpx;
  font-size: 22rpx;
}

.current-summary {
  padding: 10rpx 0 18rpx;
}

.current-summary view {
  margin-bottom: 10rpx;
  color: #584735;
  font-family: var(--font-numeral);
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.current-summary text {
  color: #85715b;
  font-size: 25rpx;
}

.view-report-button {
  height: 76rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(126,91,48,.55);
  border-radius: 8rpx;
  background: linear-gradient(135deg,#d8bd91,#c49d68);
  color: #30251a;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
  box-shadow: 0 8rpx 17rpx rgba(94,65,29,.14);
}

.button-arrow {
  font-family: var(--font-numeral);
  font-size: 42rpx;
  font-weight: 400;
}

.history-panel {
  display: flex;
  flex-direction: column;
}

.history-heading {
  flex: none;
  margin-bottom: 20rpx;
}

.archive-count {
  min-width: 50rpx;
  height: 50rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  line-height: 50rpx;
  text-align: center;
  border: 1rpx solid rgba(137,103,62,.35);
  border-radius: 25rpx;
  color: #80613c;
  font-family: var(--font-numeral);
  font-size: 24rpx;
}

.history-list {
  min-height: 0;
  flex: 1;
}

.history-row {
  min-height: 91rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid rgba(127,96,58,.18);
}

.history-row:last-child {
  border-bottom: 1rpx solid rgba(127,96,58,.18);
}

.history-month {
  width: 36%;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.history-month text:first-child {
  color: #3d3024;
  font-size: 30rpx;
  font-weight: 500;
}

.history-month text:last-child,
.history-meta {
  color: #96816a;
  font-family: var(--font-numeral);
  font-size: 21rpx;
}

.history-meta {
  flex: 1;
}

.history-link {
  width: 31%;
  text-align: right;
  color: #795a35;
  font-size: 23rpx;
}

.history-link text {
  margin-left: 8rpx;
  font-family: var(--font-numeral);
  font-size: 34rpx;
}

.history-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6f5d49;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.empty-mark {
  margin-bottom: 16rpx;
  color: #b18b59;
  font-size: 32rpx;
}

.history-empty text {
  margin-top: 14rpx;
  color: #a18d77;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}
