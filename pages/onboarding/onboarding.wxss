.onboarding-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #d8c6ac;
}

.onboarding-art {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.onboarding-shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(36, 27, 18, .12), rgba(39, 28, 17, .2)),
    linear-gradient(0deg, rgba(239, 226, 206, .92) 0, rgba(239, 226, 206, .68) 42%, transparent 72%);
}

.onboarding-content {
  position: absolute;
  left: 54rpx;
  right: 54rpx;
  bottom: calc(88rpx + env(safe-area-inset-bottom));
  padding: 54rpx 44rpx 42rpx;
  border: 1rpx solid rgba(255, 252, 244, .75);
  border-radius: 24rpx;
  background: rgba(249, 243, 233, .92);
  box-shadow: 0 24rpx 60rpx rgba(54, 37, 18, .2);
  text-align: center;
}

.museum-seal {
  width: 74rpx;
  height: 74rpx;
  margin: 0 auto 30rpx;
  border: 4rpx double #947044;
  color: #805d35;
  font-size: 38rpx;
  font-weight: 500;
  line-height: 74rpx;
}

.onboarding-title {
  color: #31281f;
  font-size: 42rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
}

.onboarding-rule {
  margin-top: 18rpx;
  color: #b08b58;
  font-size: 19rpx;
  letter-spacing: 5rpx;
}

.onboarding-subtitle {
  margin-top: 18rpx;
  color: #766756;
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
}

.onboarding-button {
  height: 92rpx;
  margin-top: 52rpx;
  border-radius: 12rpx;
  color: #fffaf0;
  background: linear-gradient(100deg, #76562f, #a47b43);
  font-size: 29rpx;
  font-weight: 500;
  letter-spacing: 5rpx;
  line-height: 92rpx;
}

.onboarding-button::after {
  border: 0;
}
