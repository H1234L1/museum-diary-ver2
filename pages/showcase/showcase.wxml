<view class="private-museum">
  <image class="museum-wall" src="/assets/art/private-wall-bg.jpg" mode="aspectFill"></image>
  <view class="wall-veil"></view>
  <view class="wall-light"></view>

  <view class="showcase-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="showcase-nav-row" style="height: {{navigationBarHeight}}px;">
      <view class="showcase-back" bindtap="goBack"></view>
      <view class="showcase-nav-title">{{hallName}}</view>
    </view>
  </view>

  <view
    class="overview-button"
    style="top: calc({{statusBarHeight}}px + {{navigationBarHeight}}px + 12rpx);"
    bindtap="openOverview"
  >切换到作品概览</view>

  <view class="gallery-identity">
    <view class="gallery-name">{{hallName}}</view>
    <view class="gallery-rule"></view>
    <view class="gallery-subtitle">{{hallSubtitle}}</view>
  </view>

  <view
    wx:if="{{!showingAddSlot}}"
    class="single-installation installation-{{currentExhibit.type}}"
    data-id="{{currentExhibit.id}}"
    data-type="{{currentExhibit.type}}"
    bindtap="openExhibit"
  >
    <view class="installation-aura"></view>
    <view class="hanging-wire wire-left"></view>
    <view class="hanging-wire wire-right"></view>
    <view class="collection-shadow"></view>
    <view class="frame-backplate"></view>
    <view class="collection-frame">
      <view class="frame-bevel">
        <view class="collection-mat">
          <image
            wx:if="{{currentExhibit.type === 'photo' && currentExhibit.image}}"
            class="photo-preview"
            src="{{currentExhibit.image}}"
            mode="aspectFill"
          ></image>

          <view wx:elif="{{currentExhibit.type === 'text'}}" class="text-preview">
            <view class="scroll-cap scroll-cap-top"></view>
            <view class="scroll-paper">
              <view class="scroll-title">{{currentExhibit.title}}</view>
              <view class="scroll-rule"></view>
              <view class="scroll-copy">{{currentExhibit.story}}</view>
            </view>
            <view class="scroll-cap scroll-cap-bottom"></view>
          </view>

          <view wx:elif="{{currentExhibit.type === 'audio'}}" class="audio-preview">
            <view class="audio-disc"><view class="audio-center"></view></view>
            <view class="audio-wave">
              <text></text><text></text><text></text><text></text><text></text><text></text><text></text>
            </view>
            <view class="audio-label">VOICE MEMORY</view>
          </view>

          <view wx:else class="missing-preview">◇</view>
        </view>
      </view>
      <view class="exhibit-number">No.{{currentExhibit.number}}</view>
    </view>
  </view>

  <view wx:else class="empty-installation" bindtap="addExhibit">
    <view class="installation-aura empty-aura"></view>
    <view class="collection-shadow empty-shadow"></view>
    <view class="empty-backplate"></view>
    <view class="empty-frame">
      <view class="empty-inner">
        <view class="empty-plus-ring"><view class="empty-plus">＋</view></view>
        <view class="empty-copy">{{addSlotTitle}}</view>
        <view class="empty-hint">轻触放入一段人生收藏</view>
      </view>
      <view class="empty-number">No.{{nextExhibitNumber}}</view>
    </view>
  </view>

  <view class="cycle-button cycle-left {{canCycle ? '' : 'disabled'}}" bindtap="showPrevious">
    <view class="cycle-chevron"></view>
  </view>
  <view class="cycle-button cycle-right {{canCycle ? '' : 'disabled'}}" bindtap="showNext">
    <view class="cycle-chevron"></view>
  </view>

  <view class="collection-progress">{{progressText}}</view>
</view>
