page { width: 100%; height: 100%; overflow: hidden; background: #cdbb9f; }

.private-museum { position: relative; width: 100vw; height: 100vh; overflow: hidden; color: #332d26; background: #cdbb9f; font-family: var(--font-display); }
.museum-wall,.wall-veil,.wall-light { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.museum-wall { z-index: 0; display: block; }
.wall-veil { z-index: 1; background: linear-gradient(90deg,rgba(68,48,29,.20),transparent 23%,transparent 77%,rgba(68,48,29,.20)),linear-gradient(180deg,rgba(64,45,28,.12),transparent 35%,rgba(102,75,43,.08)); }
.museum-ceiling { position: absolute; left: -9%; right: -9%; top: -2vh; z-index: 3; height: 25vh; clip-path: polygon(0 0,100% 0,80% 100%,20% 100%); background: linear-gradient(180deg,rgba(235,225,208,.96),rgba(198,180,155,.82)); box-shadow: 0 18rpx 30rpx rgba(69,49,30,.17); }
.skylight { position: absolute; left: 50%; top: 0; width: 300rpx; height: 205rpx; transform: translateX(-50%) perspective(300rpx) rotateX(-15deg); background: linear-gradient(155deg,rgba(255,255,249,.95),rgba(226,216,199,.72)); border: 9rpx solid rgba(191,174,151,.74); box-shadow: inset 0 0 30rpx rgba(255,255,255,.85),0 13rpx 25rpx rgba(78,55,33,.13); }
.skylight::before,.skylight::after,.skylight-cross::before { content: ''; position: absolute; background: rgba(184,165,140,.56); }
.skylight::before { left: 50%; top: 0; bottom: 0; width: 6rpx; }.skylight::after { left: 0; right: 0; top: 50%; height: 6rpx; }.skylight-cross::before { left: 25%; top: 0; bottom: 0; width: 4rpx; box-shadow: 142rpx 0 rgba(184,165,140,.56); }
.ceiling-line { position: absolute; bottom: 8rpx; width: 48%; height: 3rpx; background: rgba(132,108,79,.34); }.ceiling-line-left { left: 0; transform: rotate(15deg); transform-origin: right; }.ceiling-line-right { right: 0; transform: rotate(-15deg); transform-origin: left; }
.museum-cornice { position: absolute; left: -4%; right: -4%; top: 22.5vh; z-index: 4; height: 27rpx; border-top: 3rpx solid rgba(107,82,54,.24); border-bottom: 2rpx solid rgba(255,248,232,.44); background: linear-gradient(180deg,rgba(203,187,163,.75),rgba(168,145,116,.42)); box-shadow: 0 11rpx 19rpx rgba(74,52,31,.13); }
.room-panel { position: absolute; top: 27vh; bottom: 20vh; z-index: 3; width: 27vw; border: 3rpx solid rgba(115,91,63,.25); background: rgba(225,212,192,.13); box-shadow: inset 0 0 18rpx rgba(255,255,255,.18); }.room-panel-left { left: -8vw; transform: perspective(400rpx) rotateY(8deg); }.room-panel-right { right: -8vw; transform: perspective(400rpx) rotateY(-8deg); }
.wall-light { left: 50%; top: 19vh; z-index: 5; width: 92vw; height: 58vh; transform: translateX(-50%); background: radial-gradient(ellipse at 50% 33%,rgba(255,252,235,.74),rgba(255,243,207,.28) 47%,rgba(255,239,196,0) 76%); }
.museum-floor { position: absolute; left: -18%; right: -18%; bottom: -5vh; z-index: 4; height: 30vh; transform: perspective(420rpx) rotateX(24deg); transform-origin: bottom; background: repeating-linear-gradient(90deg,rgba(120,91,59,.11) 0,rgba(120,91,59,.11) 2rpx,transparent 2rpx,transparent 180rpx),linear-gradient(180deg,#d2c1a8,#b9a387); border-top: 4rpx solid rgba(102,77,49,.30); box-shadow: inset 0 18rpx 30rpx rgba(92,67,41,.09); }.floor-seam { position: absolute; left: 50%; top: 0; bottom: 0; width: 2rpx; background: rgba(107,78,47,.10); }

.showcase-nav { position: absolute; left: 0; top: 0; z-index: 40; width: 100%; }.showcase-nav-row { position: relative; width: 100%; }
.showcase-back { position: absolute; left: 38rpx; top: 50%; width: 24rpx; height: 24rpx; border-left: 4rpx solid #fffdf5; border-bottom: 4rpx solid #fffdf5; transform: translateY(-50%) rotate(45deg); filter: drop-shadow(0 2rpx 3rpx rgba(48,34,22,.35)); }
.showcase-nav-title { position: absolute; left: 86rpx; top: 50%; max-width: 350rpx; overflow: hidden; transform: translateY(-50%); color: #fffdf5; font-size: 38rpx; font-weight: 500; letter-spacing: 4rpx; text-overflow: ellipsis; white-space: nowrap; text-shadow: 0 3rpx 8rpx rgba(50,35,22,.42); }
.overview-button { position: absolute; right: 28rpx; z-index: 42; padding: 12rpx 23rpx; border: 1rpx solid rgba(255,252,242,.56); border-radius: 30rpx; background: rgba(93,74,53,.26); color: #fffdf6; font-size: 18rpx; letter-spacing: 2rpx; box-shadow: 0 8rpx 20rpx rgba(55,38,23,.12); -webkit-backdrop-filter: blur(14rpx); backdrop-filter: blur(14rpx); }
.gallery-identity { position: absolute; left: 50%; top: 25.5vh; z-index: 12; width: 68vw; transform: translateX(-50%); text-align: center; }.gallery-name { overflow: hidden; font-size: 40rpx; font-weight: 500; letter-spacing: 8rpx; text-overflow: ellipsis; white-space: nowrap; text-shadow: 0 2rpx 3rpx rgba(255,255,255,.42); }.gallery-rule { width: 74rpx; height: 1rpx; margin: 8rpx auto 5rpx; background: rgba(83,62,39,.45); }.gallery-subtitle { color: #6d5941; font-family: "Baskerville","Times New Roman",serif; font-size: 22rpx; font-style: italic; letter-spacing: 2rpx; }

.frame-gallery { position: absolute; inset: 0; z-index: 18; }
.gallery-frame { position: absolute; left: 50%; top: 38.5vh; width: 330rpx; height: 438rpx; margin-left: -165rpx; transform-origin: center center; transition: transform .44s cubic-bezier(.22,.72,.24,1),opacity .32s ease; will-change: transform,opacity; }
.frame-left { z-index: 3; opacity: .88; transform: translate3d(-245rpx,35rpx,0) scale(.67); }
.frame-right { z-index: 3; opacity: .88; transform: translate3d(245rpx,35rpx,0) scale(.67); }
.frame-center { z-index: 5; opacity: 1; transform: translate3d(0,0,0) scale(1); }
.frame-pre-left { z-index: 2; opacity: 0; transform: translate3d(-300rpx,48rpx,0) scale(.58); transition: none; }
.frame-pre-right { z-index: 2; opacity: 0; transform: translate3d(300rpx,48rpx,0) scale(.58); transition: none; }
.frame-exit-left { z-index: 1; opacity: 0; transform: translate3d(-315rpx,52rpx,0) scale(.55); }
.frame-exit-right { z-index: 1; opacity: 0; transform: translate3d(315rpx,52rpx,0) scale(.55); }
.frame-wire { position: absolute; top: -62rpx; z-index: 1; width: 2rpx; height: 64rpx; background: rgba(75,54,34,.39); transform-origin: bottom; }.frame-wire.wire-left { left: 25%; transform: rotate(19deg); }.frame-wire.wire-right { right: 25%; transform: rotate(-19deg); }
.frame-cast-shadow { position: absolute; inset: 8rpx -10rpx -15rpx 10rpx; background: rgba(57,39,23,.17); filter: blur(12rpx); box-shadow: 0 20rpx 28rpx rgba(55,38,23,.20); }
.collection-frame,.empty-frame { position: absolute; inset: 0; z-index: 3; box-sizing: border-box; padding: 14rpx 14rpx 60rpx; border: 2rpx solid rgba(75,50,26,.65); background: linear-gradient(135deg,#d5b879 0%,#8e6335 22%,#d4b276 48%,#936a3a 72%,#e1c58b 100%); box-shadow: inset 0 5rpx 5rpx rgba(255,241,200,.58),inset 5rpx 0 4rpx rgba(255,239,198,.22),inset 0 -6rpx 7rpx rgba(57,38,19,.30),0 9rpx 15rpx rgba(57,39,22,.25); }
.frame-bevel { box-sizing: border-box; width: 100%; height: 100%; padding: 7rpx; border: 1rpx solid rgba(65,43,22,.48); background: linear-gradient(145deg,#74502c,#d7ba7e 42%,#896038 72%,#e5ca91); box-shadow: inset 0 0 8rpx rgba(47,31,16,.34); }
.collection-mat { position: relative; box-sizing: border-box; width: 100%; height: 100%; overflow: hidden; padding: 21rpx; border: 1rpx solid rgba(80,59,36,.28); background: #e9dfce; box-shadow: inset 0 0 18rpx rgba(70,50,29,.12),inset 5rpx 5rpx 7rpx rgba(255,255,255,.52); }
.photo-preview,.missing-preview { display: block; width: 100%; height: 100%; }.photo-preview { box-shadow: 0 6rpx 13rpx rgba(45,32,20,.25); }.missing-preview { box-sizing: border-box; padding-top: 42%; background: #c8bba6; color: #876c49; font-size: 42rpx; text-align: center; }
.add-preview { width: 100%; height: 100%; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; background: repeating-linear-gradient(45deg,rgba(123,94,59,.025) 0,rgba(123,94,59,.025) 1rpx,transparent 1rpx,transparent 8rpx),linear-gradient(145deg,#eee4d3,#d8c5a8); box-shadow: inset 0 0 24rpx rgba(85,61,35,.11); }
.add-plus { color: #7b5b35; font-family: var(--font-numeral); font-size: 88rpx; font-weight: 300; line-height: 1; }
.add-preview-title { margin-top: 24rpx; color: #564431; font-size: 25rpx; font-weight: 500; letter-spacing: 3rpx; }
.exhibit-number,.empty-number { position: absolute; left: 0; right: 0; bottom: 17rpx; color: #30271e; font-family: var(--font-numeral); font-size: 29rpx; line-height: 1; letter-spacing: 2rpx; text-align: center; text-shadow: 0 1rpx rgba(255,248,226,.58); }

.text-preview { position: relative; width: 100%; height: 100%; padding: 9rpx 5rpx; box-sizing: border-box; }.scroll-paper { position: absolute; left: 5%; right: 5%; top: 8%; bottom: 8%; box-sizing: border-box; overflow: hidden; padding: 20rpx 15rpx; background: #eee3cf; box-shadow: inset 9rpx 0 13rpx rgba(102,74,42,.10),inset -9rpx 0 13rpx rgba(102,74,42,.10),0 7rpx 11rpx rgba(60,42,24,.16); }.scroll-cap { position: absolute; left: 0; right: 0; z-index: 2; height: 15rpx; border-radius: 9rpx; background: linear-gradient(180deg,#b18a59,#785431); box-shadow: 0 4rpx 7rpx rgba(56,39,21,.30); }.scroll-cap-top { top: 5%; }.scroll-cap-bottom { bottom: 5%; }.scroll-rule { width: 34rpx; height: 1rpx; margin: 3rpx auto 12rpx; background: #987044; }.scroll-copy { display: -webkit-box; overflow: hidden; color: #5c4c3a; font-size: 21rpx; line-height: 1.72; -webkit-line-clamp: 10; -webkit-box-orient: vertical; }
.audio-preview { position: relative; width: 100%; height: 100%; overflow: hidden; background: linear-gradient(145deg,#c5b08d,#a88f6d); box-shadow: inset 0 0 24rpx rgba(61,45,29,.16); }.audio-disc { position: absolute; left: 50%; top: 19%; width: 126rpx; height: 126rpx; border: 3rpx solid rgba(54,42,30,.58); border-radius: 50%; transform: translateX(-50%); background: repeating-radial-gradient(circle,#6f5c49 0,#6f5c49 2rpx,#99836a 3rpx,#99836a 5rpx); box-shadow: 0 10rpx 17rpx rgba(46,34,23,.27); }.audio-center { position: absolute; left: 50%; top: 50%; width: 21rpx; height: 21rpx; border: 2rpx solid #594735; border-radius: 50%; transform: translate(-50%,-50%); background: #d8c092; }.audio-wave { position: absolute; left: 14%; right: 14%; bottom: 18%; height: 42rpx; display: flex; align-items: center; justify-content: space-between; }.audio-wave text { width: 3rpx; height: 15rpx; background: #544536; }.audio-wave text:nth-child(2),.audio-wave text:nth-child(6) { height: 27rpx; }.audio-wave text:nth-child(3),.audio-wave text:nth-child(5) { height: 38rpx; }.audio-wave text:nth-child(4) { height: 22rpx; }.audio-label { position: absolute; left: 0; right: 0; bottom: 5%; color: #5b4b3a; font-family: var(--font-numeral); font-size: 12rpx; letter-spacing: 2rpx; text-align: center; }

.empty-installation { position: absolute; left: 50%; top: 41vh; z-index: 18; width: 330rpx; height: 420rpx; transform: translateX(-50%); }.empty-aura { position: absolute; left: 50%; top: -90rpx; width: 580rpx; height: 570rpx; transform: translateX(-50%); background: radial-gradient(ellipse,rgba(255,245,214,.42),rgba(255,238,195,.13) 48%,rgba(255,238,195,0) 74%); }.empty-frame { padding: 14rpx 14rpx 60rpx; background: linear-gradient(135deg,#d3b98f,#a88a63 45%,#c1a47b 72%,#927452); }.empty-inner { box-sizing: border-box; width: 100%; height: 100%; padding-top: 80rpx; border: 1rpx solid rgba(112,87,57,.30); background: rgba(239,231,217,.78); text-align: center; }.empty-plus-ring { width: 88rpx; height: 88rpx; margin: 0 auto; border: 1rpx solid rgba(129,96,57,.46); border-radius: 50%; background: rgba(255,250,240,.35); }.empty-plus { color: #816039; font-family: var(--font-numeral); font-size: 62rpx; line-height: 80rpx; }.empty-copy { margin-top: 21rpx; color: #5f4d38; font-size: 23rpx; letter-spacing: 2rpx; }.empty-hint { margin-top: 10rpx; color: rgba(101,82,59,.66); font-size: 17rpx; }
.cycle-button { position: absolute; top: 78vh; z-index: 30; width: 82rpx; height: 82rpx; border: 1rpx solid rgba(255,252,243,.65); border-radius: 50%; background: rgba(103,82,59,.18); box-shadow: 0 12rpx 23rpx rgba(61,43,26,.14),inset 0 1rpx rgba(255,255,255,.55); -webkit-backdrop-filter: blur(10rpx); backdrop-filter: blur(10rpx); }.cycle-left { left: 42rpx; }.cycle-right { right: 42rpx; }.cycle-button.disabled { opacity: .25; }.cycle-chevron { position: absolute; left: 50%; top: 50%; width: 18rpx; height: 18rpx; border-left: 5rpx solid #fffdf6; border-bottom: 5rpx solid #fffdf6; filter: drop-shadow(0 2rpx 3rpx rgba(56,39,23,.3)); }.cycle-left .cycle-chevron { transform: translate(-35%,-50%) rotate(45deg); }.cycle-right .cycle-chevron { transform: translate(-65%,-50%) rotate(225deg); }
.collection-progress { position: absolute; left: 50%; bottom: calc(37rpx + env(safe-area-inset-bottom)); z-index: 20; transform: translateX(-50%); color: rgba(72,52,33,.70); font-family: var(--font-numeral); font-size: 19rpx; letter-spacing: 3rpx; }

@media (max-height: 700px) { .gallery-identity { top: 24vh; }.gallery-frame { top: 36vh; }.frame-left { transform: translate3d(-235rpx,32rpx,0) scale(.58); }.frame-right { transform: translate3d(235rpx,32rpx,0) scale(.58); }.frame-center { transform: translate3d(0,0,0) scale(.86); }.frame-pre-left { transform: translate3d(-285rpx,44rpx,0) scale(.5); }.frame-pre-right { transform: translate3d(285rpx,44rpx,0) scale(.5); }.frame-exit-left { transform: translate3d(-300rpx,48rpx,0) scale(.48); }.frame-exit-right { transform: translate3d(300rpx,48rpx,0) scale(.48); }.cycle-button { top: 76vh; } }
