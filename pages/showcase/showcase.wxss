page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #d8c8ad;
}

.private-museum {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  color: #332d26;
  background: #d8c8ad;
  font-family: var(--font-display);
}

.museum-wall,
.wall-veil,
.wall-light {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.museum-wall {
  z-index: 0;
  display: block;
}

.wall-veil {
  z-index: 1;
  background: linear-gradient(180deg, rgba(84,63,39,.10), rgba(255,252,243,.01) 31%, rgba(83,61,37,.10));
}

.wall-light {
  left: 50%;
  top: 24vh;
  z-index: 2;
  width: 76vw;
  height: 57vh;
  transform: translateX(-50%);
  background: radial-gradient(ellipse, rgba(255,249,228,.46) 0%, rgba(255,240,202,.16) 48%, rgba(255,240,202,0) 76%);
}

.showcase-nav {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 40;
  width: 100%;
}

.showcase-nav-row {
  position: relative;
  width: 100%;
}

.showcase-back {
  position: absolute;
  left: 38rpx;
  top: 50%;
  width: 23rpx;
  height: 23rpx;
  border-left: 4rpx solid #4a4034;
  border-bottom: 4rpx solid #4a4034;
  transform: translateY(-50%) rotate(45deg);
}

.showcase-nav-title {
  position: absolute;
  left: 84rpx;
  top: 50%;
  max-width: 315rpx;
  overflow: hidden;
  transform: translateY(-50%);
  color: #3c342a;
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-button {
  position: absolute;
  right: 28rpx;
  z-index: 42;
  box-sizing: border-box;
  width: 188rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid rgba(94,70,43,.34);
  border-radius: 30rpx;
  background: rgba(241,232,216,.67);
  color: #5a4833;
  font-size: 18rpx;
  line-height: 1.25;
  letter-spacing: 1rpx;
  text-align: center;
  box-shadow: 0 9rpx 22rpx rgba(66,47,28,.11), inset 0 1rpx rgba(255,255,255,.62);
  -webkit-backdrop-filter: blur(14rpx);
  backdrop-filter: blur(14rpx);
}

.gallery-identity {
  position: absolute;
  left: 50%;
  top: 22.8vh;
  z-index: 10;
  width: 68vw;
  transform: translateX(-50%);
  text-align: center;
}

.gallery-name {
  overflow: hidden;
  font-size: 42rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-shadow: 0 2rpx 2rpx rgba(255,255,255,.38);
}

.gallery-rule {
  width: 96rpx;
  height: 1rpx;
  margin: 10rpx auto 6rpx;
  background: rgba(83,62,39,.45);
}

.gallery-subtitle {
  color: #6d5941;
  font-family: "Baskerville", "Times New Roman", serif;
  font-size: 28rpx;
  font-style: italic;
  letter-spacing: 2rpx;
}

.single-installation,
.empty-installation {
  position: absolute;
  left: 50%;
  top: 39vh;
  z-index: 18;
  width: 352rpx;
  height: 436rpx;
  transform: translateX(-50%);
}

.installation-aura {
  position: absolute;
  left: 50%;
  top: -82rpx;
  z-index: 0;
  width: 580rpx;
  height: 570rpx;
  transform: translateX(-50%);
  background: radial-gradient(ellipse, rgba(255,245,214,.42), rgba(255,238,195,.13) 48%, rgba(255,238,195,0) 74%);
  pointer-events: none;
}

.hanging-wire {
  position: absolute;
  top: -70rpx;
  width: 2rpx;
  height: 74rpx;
  z-index: 2;
  background: rgba(78,57,35,.36);
  box-shadow: 1rpx 0 rgba(255,255,255,.22);
  transform-origin: bottom;
}

.wire-left { left: 24%; transform: rotate(15deg); }
.wire-right { right: 24%; transform: rotate(-15deg); }

.collection-shadow,
.empty-shadow {
  position: absolute;
  left: 12rpx;
  right: -13rpx;
  top: 17rpx;
  bottom: -18rpx;
  z-index: 1;
  background: rgba(74,53,31,.08);
  filter: blur(13rpx);
  box-shadow: 0 25rpx 38rpx rgba(57,41,25,.27);
}

.frame-backplate,
.empty-backplate {
  position: absolute;
  inset: 6rpx -7rpx -8rpx 7rpx;
  z-index: 2;
  background: #80603c;
  border: 1rpx solid rgba(61,41,21,.42);
  box-shadow: 5rpx 7rpx 9rpx rgba(56,39,22,.23);
}

.collection-frame,
.empty-frame {
  position: absolute;
  inset: 0;
  z-index: 3;
  box-sizing: border-box;
  padding: 14rpx 14rpx 64rpx;
  background: linear-gradient(135deg, #d4b580 0%, #a57d4b 24%, #c59e67 56%, #8d693f 100%);
  border: 2rpx solid rgba(77,52,27,.62);
  box-shadow:
    inset 0 5rpx 5rpx rgba(255,244,213,.58),
    inset 5rpx 0 4rpx rgba(255,239,198,.24),
    inset 0 -6rpx 7rpx rgba(57,38,19,.30),
    inset -5rpx 0 5rpx rgba(57,38,19,.22);
}

.frame-bevel {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  padding: 8rpx;
  background: linear-gradient(145deg, #7e5c36, #d3b681 42%, #977044 72%, #e0c695);
  border: 1rpx solid rgba(65,43,22,.48);
  box-shadow: inset 0 0 8rpx rgba(47,31,16,.30);
}

.collection-mat {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  overflow: hidden;
  padding: 23rpx;
  background: #e9dfce;
  border: 1rpx solid rgba(80,59,36,.29);
  box-shadow:
    inset 0 0 19rpx rgba(70,50,29,.12),
    inset 5rpx 5rpx 7rpx rgba(255,255,255,.52);
}

.photo-preview,
.missing-preview {
  display: block;
  width: 100%;
  height: 100%;
}

.photo-preview {
  box-shadow: 0 7rpx 15rpx rgba(45,32,20,.26);
}

.missing-preview {
  box-sizing: border-box;
  padding-top: 42%;
  background: #c8bba6;
  color: #876c49;
  font-size: 52rpx;
  text-align: center;
}

.exhibit-number,
.empty-number {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 17rpx;
  color: #33291f;
  font-family: var(--font-numeral);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 2rpx;
  text-align: center;
  text-shadow: 0 1rpx rgba(255,248,226,.55);
}

.text-preview {
  position: relative;
  width: 100%;
  height: 100%;
  padding: 12rpx 7rpx;
  box-sizing: border-box;
}

.scroll-paper {
  position: absolute;
  left: 5%;
  right: 5%;
  top: 8%;
  bottom: 8%;
  box-sizing: border-box;
  overflow: hidden;
  padding: 25rpx 21rpx;
  background: #eee3cf;
  box-shadow:
    inset 12rpx 0 16rpx rgba(102,74,42,.10),
    inset -12rpx 0 16rpx rgba(102,74,42,.10),
    0 8rpx 13rpx rgba(60,42,24,.16);
}

.scroll-cap {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 2;
  height: 18rpx;
  border-radius: 9rpx;
  background: linear-gradient(180deg, #b18a59, #785431);
  box-shadow: 0 4rpx 7rpx rgba(56,39,21,.30), inset 0 2rpx rgba(255,232,190,.34);
}

.scroll-cap-top { top: 5%; }
.scroll-cap-bottom { bottom: 5%; }
.scroll-title { overflow: hidden; font-size: 26rpx; font-weight: 500; white-space: nowrap; text-overflow: ellipsis; }
.scroll-rule { width: 40rpx; height: 1rpx; margin: 12rpx auto; background: #987044; }
.scroll-copy { display: -webkit-box; overflow: hidden; color: #665643; font-size: 19rpx; line-height: 1.75; -webkit-line-clamp: 7; -webkit-box-orient: vertical; }

.audio-preview {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: linear-gradient(145deg, #c5b08d, #a88f6d);
  box-shadow: inset 0 0 24rpx rgba(61,45,29,.16);
}

.audio-disc {
  position: absolute;
  left: 50%;
  top: 20%;
  width: 124rpx;
  height: 124rpx;
  border: 4rpx solid rgba(54,42,30,.58);
  border-radius: 50%;
  transform: translateX(-50%);
  background: repeating-radial-gradient(circle, #6f5c49 0, #6f5c49 2rpx, #99836a 3rpx, #99836a 5rpx);
  box-shadow: 0 12rpx 20rpx rgba(46,34,23,.27), inset 0 2rpx 4rpx rgba(255,255,255,.16);
}

.audio-center {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 23rpx;
  height: 23rpx;
  border: 2rpx solid #594735;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background: #d8c092;
}

.audio-wave {
  position: absolute;
  left: 14%;
  right: 14%;
  bottom: 18%;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.audio-wave text { width: 3rpx; height: 17rpx; background: #544536; box-shadow: 1rpx 0 rgba(255,255,255,.18); }
.audio-wave text:nth-child(2), .audio-wave text:nth-child(6) { height: 30rpx; }
.audio-wave text:nth-child(3), .audio-wave text:nth-child(5) { height: 42rpx; }
.audio-wave text:nth-child(4) { height: 24rpx; }
.audio-label { position: absolute; left: 0; right: 0; bottom: 5%; color: #5b4b3a; font-family: var(--font-numeral); font-size: 14rpx; letter-spacing: 3rpx; text-align: center; }

.empty-aura {
  opacity: .72;
}

.empty-backplate {
  background: #a38661;
}

.empty-frame {
  padding: 14rpx 14rpx 64rpx;
  background: linear-gradient(135deg, #d3b98f, #a88a63 45%, #c1a47b 72%, #927452);
}

.empty-inner {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  padding-top: 86rpx;
  border: 1rpx solid rgba(112,87,57,.30);
  background: rgba(239,231,217,.75);
  box-shadow: inset 0 0 24rpx rgba(81,59,36,.10), inset 0 0 0 8rpx rgba(255,255,255,.16);
  text-align: center;
}

.empty-plus-ring {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto;
  border: 1rpx solid rgba(129,96,57,.46);
  border-radius: 50%;
  background: rgba(255,250,240,.35);
  box-shadow: 0 9rpx 18rpx rgba(76,54,31,.10), inset 0 1rpx rgba(255,255,255,.65);
}

.empty-plus {
  color: #816039;
  font-family: var(--font-numeral);
  font-size: 67rpx;
  font-weight: 400;
  line-height: 83rpx;
}

.empty-copy {
  margin-top: 22rpx;
  color: #5f4d38;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.empty-hint {
  margin-top: 11rpx;
  color: rgba(101,82,59,.66);
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.cycle-button {
  position: absolute;
  top: 70.8vh;
  z-index: 30;
  width: 82rpx;
  height: 82rpx;
  border: 1rpx solid rgba(101,75,45,.38);
  border-radius: 50%;
  background: rgba(239,230,214,.60);
  box-shadow: 0 12rpx 23rpx rgba(61,43,26,.14), inset 0 1rpx rgba(255,255,255,.70);
  -webkit-backdrop-filter: blur(10rpx);
  backdrop-filter: blur(10rpx);
}

.cycle-left { left: 40rpx; }
.cycle-right { right: 40rpx; }
.cycle-button.disabled { opacity: .25; }

.cycle-chevron {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #5f4d38;
  border-bottom: 4rpx solid #5f4d38;
}

.cycle-left .cycle-chevron { transform: translate(-35%, -50%) rotate(45deg); }
.cycle-right .cycle-chevron { transform: translate(-65%, -50%) rotate(225deg); }

.collection-progress {
  position: absolute;
  left: 50%;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 20;
  transform: translateX(-50%);
  color: rgba(78,59,39,.68);
  font-family: var(--font-numeral);
  font-size: 20rpx;
  letter-spacing: 3rpx;
}
