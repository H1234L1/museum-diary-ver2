<view class="home-page">
  <view class="home-hero">
    <image class="hero-art" src="/assets/art/home-hero.jpg" mode="aspectFill"></image>
    <view class="hero-shade"></view>
    <navigator
      class="profile-button"
      url="/pages/profile/profile"
      open-type="redirect"
      hover-class="profile-button-hover"
      aria-label="打开我的页面"
    >
      <view class="profile-icon">
        <view class="profile-icon-head"></view>
        <view class="profile-icon-body"></view>
      </view>
    </navigator>
    <view class="museum-title">
      <view>人生博物馆</view>
      <text>Life Museum</text>
      <view class="title-rule">— ◆ —</view>
    </view>
  </view>

  <view class="home-actions">
    <navigator class="collect-card" url="/pages/record/record?new=1" open-type="redirect">
      <view class="collect-title"><text class="plus">＋</text> 收藏一件展品</view>
      <view class="collect-subtitle">记录每一段独特的人生故事</view>
    </navigator>

    <view
      class="stats-card"
      bindtap="openGallery"
      hover-class="stats-card-hover"
      hover-stay-time="90"
      aria-label="进入展厅"
    >
      <view class="stat">
        <view class="stat-label">馆藏总数</view>
        <view><text class="stat-number">{{exhibitCount}}</text><text class="stat-unit">件</text></view>
      </view>
      <view class="stat-line"></view>
      <view class="stat">
        <view class="stat-label">入馆天数</view>
        <view><text class="stat-number">{{museumDays}}</text><text class="stat-unit">天</text></view>
      </view>
    </view>
  </view>

  <museum-guide id="museumGuide" bind:action="handleTutorialAction"></museum-guide>
  <museum-nav id="museumNav" active="home"></museum-nav>
</view>
<view wx:if="{{entranceCoverVisible}}" class="entrance-cover {{entranceCoverLeaving ? 'is-leaving' : ''}}">
  <image src="/assets/art/home-hero.jpg" mode="aspectFill" bindload="handleEntranceCoverLoaded"></image>
  <view class="entrance-cover-wash"></view>
</view>
