.gallery-page { min-height: 100vh; box-sizing: border-box; padding: calc(65rpx + env(safe-area-inset-top)) 50rpx 0; background: linear-gradient(145deg,#f7f2ea,#e9dfd2); }
.page-title { margin-bottom: 54rpx; font-size: 58rpx; letter-spacing: 6rpx; }.section-line { display: flex; align-items: center; justify-content: space-between; }.section-title { font-size: 38rpx; letter-spacing: 4rpx; }.section-title.small { font-size: 34rpx; }
.main-hall { position: relative; height: 420rpx; margin-top: 26rpx; overflow: hidden; border-radius: 22rpx; color: #fff; box-shadow: 0 18rpx 45rpx rgba(48,34,20,.18); }.main-hall image,.created-hall-card image { width: 100%; height: 100%; display: block; }.card-gradient { position: absolute; inset: 0; background: linear-gradient(90deg,rgba(25,18,12,.52),rgba(30,22,15,.05) 72%,rgba(20,14,9,.16)); }.main-copy { position: absolute; left: 38rpx; bottom: 44rpx; }.hall-name { font-size: 55rpx; }.hall-meta,.hall-count { margin-top: 10rpx; font-size: 27rpx; }.short-rule { width: 40rpx; height: 2rpx; margin-top: 19rpx; background: rgba(255,255,255,.85); }.round-arrow { position: absolute; right: 35rpx; bottom: 35rpx; width: 68rpx; height: 68rpx; border: 2rpx solid rgba(255,255,255,.9); border-radius: 50%; line-height: 62rpx; text-align: center; font-size: 55rpx; }
.sub-heading { margin-top: 54rpx; }.hall-total { color: #8d7a64; font-size: 23rpx; }.subhall-grid { margin-top: 24rpx; display: flex; flex-wrap: wrap; gap: 22rpx; }.created-hall-card,.create-hall-card.compact { width: calc(50% - 11rpx); height: 310rpx; box-sizing: border-box; }
.created-hall-card { position: relative; overflow: hidden; border-radius: 18rpx; color: #fff; background: #cdbca5; box-shadow: 0 13rpx 28rpx rgba(67,45,23,.14); }.default-cover { width: 100%; height: 100%; display: flex; align-items: flex-end; justify-content: center; background: linear-gradient(145deg,#cbb99f,#a99173); }.cover-arch { width: 58%; height: 76%; border: 3rpx solid rgba(255,245,224,.36); border-bottom: 0; border-radius: 150rpx 150rpx 0 0; }.created-overlay { position: absolute; inset: 0; background: linear-gradient(180deg,rgba(31,23,16,.02) 20%,rgba(31,23,16,.76)); }.created-copy { position: absolute; left: 22rpx; right: 22rpx; bottom: 24rpx; padding-right: 32rpx; }.created-name { font-size: 31rpx; font-weight: 500; letter-spacing: 2rpx; }.created-description { margin-top: 8rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: rgba(255,255,255,.82); font-size: 21rpx; }.created-copy text { display: block; margin-top: 9rpx; font-size: 21rpx; }.mini-arrow { position: absolute; right: 16rpx; bottom: 17rpx; width: 42rpx; height: 42rpx; border: 1rpx solid rgba(255,255,255,.9); border-radius: 50%; line-height: 37rpx; text-align: center; font-size: 33rpx; }
.create-hall-card { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed rgba(133,101,64,.42); border-radius: 18rpx; background: rgba(255,250,241,.38); color: #826541; box-shadow: inset 0 0 0 1rpx rgba(255,255,255,.4); }.create-hall-card.empty { width: 100%; height: 260rpx; }.create-plus { font-family: var(--font-numeral); font-size: 68rpx; font-weight: 400; line-height: 1; }.create-title { margin-top: 12rpx; font-size: 29rpx; font-weight: 500; letter-spacing: 3rpx; }.create-hall-card text { margin-top: 15rpx; color: #a08a70; font-size: 22rpx; }
.gallery-bottom-space { height: calc(155rpx + env(safe-area-inset-bottom)); }
.creator-mask { position: fixed; inset: 0; z-index: 200; display: flex; align-items: flex-end; background: rgba(39,31,24,.52); }.creator-sheet { width: 100%; max-height: 90vh; padding: 18rpx 42rpx calc(34rpx + env(safe-area-inset-bottom)); box-sizing: border-box; overflow-y: auto; border-radius: 34rpx 34rpx 0 0; background: linear-gradient(155deg,#faf6ef,#eee3d5); box-shadow: 0 -18rpx 45rpx rgba(37,27,18,.2); }.sheet-handle { width: 72rpx; height: 7rpx; margin: 0 auto 28rpx; border-radius: 5rpx; background: rgba(113,91,66,.3); }.creator-heading { display: flex; justify-content: space-between; align-items: flex-start; }.creator-kicker { margin-bottom: 10rpx; color: #a08461; font-family: var(--font-numeral); font-size: 18rpx; letter-spacing: 3rpx; }.creator-title { font-size: 42rpx; font-weight: 500; letter-spacing: 4rpx; }.creator-close { width: 60rpx; height: 60rpx; line-height: 54rpx; text-align: center; border: 1rpx solid rgba(122,94,61,.25); border-radius: 50%; color: #715d46; font-size: 40rpx; }.creator-note { margin: 20rpx 0 34rpx; color: #8a7762; font-size: 24rpx; line-height: 1.7; }.field-label { margin: 24rpx 0 12rpx; color: #493b2d; font-size: 25rpx; font-weight: 500; }.field-label text { margin-left: 10rpx; color: #a38e76; font-size: 19rpx; font-weight: 400; }.hall-input { height: 80rpx; padding: 0 23rpx; border: 1rpx solid rgba(137,104,64,.3); border-radius: 10rpx; background: rgba(255,252,246,.68); color: #342a20; font-family: var(--font-display); font-size: 27rpx; }.cover-label { margin-top: 30rpx; }.cover-list { width: calc(100% + 42rpx); }.cover-row { display: flex; gap: 16rpx; padding: 2rpx 42rpx 6rpx 2rpx; }.cover-choice { position: relative; flex: none; width: 126rpx; height: 126rpx; box-sizing: border-box; overflow: hidden; border: 3rpx solid transparent; border-radius: 12rpx; background: #d5c4ac; }.cover-choice.selected { border-color: #99703c; box-shadow: 0 0 0 3rpx rgba(153,112,60,.14); }.cover-choice image { width: 100%; height: 100%; display: block; }.default-choice { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #6e5940; }.small-arch { width: 45rpx; height: 53rpx; border: 2rpx solid #8c6c45; border-bottom: 0; border-radius: 28rpx 28rpx 0 0; }.default-choice text { margin-top: 8rpx; font-size: 19rpx; }.creator-actions { margin-top: 38rpx; display: flex; gap: 18rpx; }.creator-actions button { height: 82rpx; margin: 0; padding: 0; flex: 1; line-height: 82rpx; border-radius: 10rpx; font-family: var(--font-display); font-size: 27rpx; font-weight: 500; }.creator-actions button::after { border: 0; }.cancel-button { border: 1rpx solid rgba(128,96,57,.3); background: rgba(255,250,242,.58); color: #705d47; }.create-button { background: linear-gradient(135deg,#ad8651,#8c642f); color: #fffaf0; box-shadow: 0 9rpx 18rpx rgba(101,70,31,.18); }
