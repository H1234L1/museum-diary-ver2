.nav-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  height: 120rpx;
  box-sizing: border-box;
  display: flex;
  background: rgba(248, 243, 235, .98);
  border-top: 1rpx solid rgba(139, 111, 76, .2);
  box-shadow: 0 -10rpx 30rpx rgba(66, 45, 23, .07);
}
.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #6d6256;
}
.nav-icon {
  position: relative;
  width: 58rpx;
  height: 54rpx;
  color: inherit;
}
.nav-label {
  margin-top: 7rpx;
  font-size: 23rpx;
}
.nav-item.active {
  color: #8f6328;
  font-weight: 600;
}
.nav-hover {
  background: rgba(149, 111, 57, .08);
}

/* 主页：博物馆立面 */
.museum-roof {
  position: absolute;
  top: 1rpx;
  left: 3rpx;
  width: 52rpx;
  height: 12rpx;
  background: currentColor;
  clip-path: polygon(50% 0,100% 78%,94% 100%,6% 100%,0 78%);
}
.museum-body {
  position: absolute;
  top: 15rpx;
  left: 8rpx;
  width: 42rpx;
  height: 27rpx;
  display: flex;
  justify-content: space-around;
  border-top: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
}
.museum-body .column {
  width: 4rpx;
  height: 25rpx;
  background: currentColor;
}
.museum-base {
  position: absolute;
  left: 3rpx;
  bottom: 2rpx;
  width: 52rpx;
  height: 4rpx;
  border-top: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
}

/* 展厅：装饰画框 */
.icon-gallery {
  box-sizing: border-box;
  border: 3rpx solid currentColor;
}
.frame-inner {
  position: absolute;
  inset: 9rpx;
  border: 3rpx solid currentColor;
  display: flex;
  align-items: center;
  justify-content: center;
}
.frame-dot {
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}
.frame-corner {
  position: absolute;
  z-index: 2;
  width: 9rpx;
  height: 9rpx;
  border: 3rpx solid currentColor;
  background: #f8f3eb;
}
.corner-tl { left: -5rpx; top: -5rpx; }
.corner-tr { right: -5rpx; top: -5rpx; }
.corner-bl { left: -5rpx; bottom: -5rpx; }
.corner-br { right: -5rpx; bottom: -5rpx; }

/* 记录：纸张与铅笔 */
.record-sheet {
  position: absolute;
  left: 3rpx;
  bottom: 1rpx;
  width: 39rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 3rpx;
}
.record-pencil {
  position: absolute;
  top: 6rpx;
  right: 4rpx;
  width: 8rpx;
  height: 43rpx;
  transform: rotate(43deg);
  border: 3rpx solid currentColor;
  border-radius: 4rpx 4rpx 0 0;
  background: #f8f3eb;
}
.record-pencil::after {
  content: "";
  position: absolute;
  left: -3rpx;
  bottom: -10rpx;
  width: 8rpx;
  height: 8rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(-45deg);
}

/* 总结：陈列柜与藏品 */
.display-top {
  position: absolute;
  left: 6rpx;
  top: 1rpx;
  width: 46rpx;
  height: 10rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
}
.display-case {
  position: absolute;
  left: 8rpx;
  top: 13rpx;
  width: 42rpx;
  height: 34rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-top-width: 7rpx;
  overflow: hidden;
}
.display-mountain {
  position: absolute;
  left: 5rpx;
  bottom: 2rpx;
  width: 26rpx;
  height: 18rpx;
  border-left: 3rpx solid currentColor;
  border-top: 3rpx solid currentColor;
  transform: rotate(45deg) skew(-7deg,-7deg);
}
.display-sun {
  position: absolute;
  right: 5rpx;
  top: 8rpx;
  width: 6rpx;
  height: 6rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}
.display-tag {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 17rpx;
  height: 18rpx;
  border: 2rpx solid currentColor;
  background: #f8f3eb;
}

/* 我的：人物轮廓 */
.profile-head {
  position: absolute;
  top: 0;
  left: 19rpx;
  width: 20rpx;
  height: 20rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}
.profile-body {
  position: absolute;
  left: 7rpx;
  bottom: 1rpx;
  width: 44rpx;
  height: 27rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 23rpx 23rpx 8rpx 8rpx;
}
