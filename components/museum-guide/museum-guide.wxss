.guide-choice-mask { position: fixed; inset: 0; z-index: 190; display: flex; align-items: center; justify-content: center; padding: 40rpx; box-sizing: border-box; background: rgba(39,31,24,.52); -webkit-backdrop-filter: blur(5rpx); backdrop-filter: blur(5rpx); }
.guide-choice-card { width: 100%; max-width: 620rpx; padding: 42rpx 38rpx 34rpx; box-sizing: border-box; border: 1rpx solid rgba(132,96,52,.34); border-radius: 24rpx; background: repeating-linear-gradient(0deg,rgba(119,89,54,.018) 0,rgba(119,89,54,.018) 1rpx,transparent 1rpx,transparent 9rpx),rgba(250,246,238,.98); text-align: center; box-shadow: 0 24rpx 60rpx rgba(42,29,17,.3),inset 0 2rpx rgba(255,255,255,.85); }
.guide-choice-seal { width: 72rpx; height: 72rpx; margin: 0 auto 18rpx; border: 3rpx double #9a7446; color: #805d35; font-size: 37rpx; line-height: 72rpx; }
.guide-choice-kicker { color: #9b7a51; font-size: 20rpx; letter-spacing: 3rpx; }
.guide-choice-title { margin-top: 15rpx; color: #30261d; font-size: 35rpx; font-weight: 500; letter-spacing: 3rpx; }
.guide-choice-message { margin-top: 18rpx; color: #665645; font-size: 24rpx; line-height: 1.75; }
.guide-choice-actions { margin-top: 30rpx; display: flex; gap: 16rpx; }
.guide-choice-actions button { height: 76rpx; margin: 0; padding: 0; flex: 1; border-radius: 10rpx; font-family: var(--font-display,"Source Han Serif SC","Noto Serif SC",serif); font-size: 23rpx; line-height: 76rpx; }
.guide-choice-actions button::after { border: 0; }
.guide-choice-skip { border: 1rpx solid rgba(128,96,57,.28); background: rgba(255,251,244,.65); color: #786651; }
.guide-choice-start { background: linear-gradient(135deg,#ad8651,#8b642f); color: #fffaf0; box-shadow: 0 8rpx 17rpx rgba(99,68,31,.18); }

.guide-shell {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  z-index: 180;
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  pointer-events: none;
}

.guide-bottom { bottom: calc(128rpx + env(safe-area-inset-bottom)); }
.guide-top { top: calc(122rpx + env(safe-area-inset-top)); align-items: flex-start; }

.guide-avatar {
  position: relative;
  z-index: 2;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border: 2rpx solid rgba(117,83,42,.55);
  border-radius: 50%;
  background: linear-gradient(145deg,#d5ba8d,#9c723e);
  color: #fff8e9;
  font-family: var(--font-display,"Source Han Serif SC","Noto Serif SC",serif);
  font-size: 29rpx;
  font-weight: 500;
  box-shadow: 0 10rpx 22rpx rgba(61,42,22,.24);
  pointer-events: auto;
}

.guide-bubble {
  position: relative;
  flex: 1;
  max-width: 590rpx;
  padding: 25rpx 27rpx 22rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(124,91,52,.32);
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  background: repeating-linear-gradient(0deg,rgba(119,89,54,.018) 0,rgba(119,89,54,.018) 1rpx,transparent 1rpx,transparent 9rpx),rgba(250,246,238,.97);
  box-shadow: 0 17rpx 40rpx rgba(53,38,23,.22),inset 0 2rpx 0 rgba(255,255,255,.8);
  pointer-events: auto;
}

.guide-bubble::before {
  content: '';
  position: absolute;
  left: -13rpx;
  bottom: 22rpx;
  width: 24rpx;
  height: 24rpx;
  transform: rotate(45deg);
  border-left: 1rpx solid rgba(124,91,52,.32);
  border-bottom: 1rpx solid rgba(124,91,52,.32);
  background: #f8f3ea;
}

.guide-top .guide-bubble::before { top: 22rpx; bottom: auto; }
.guide-topline { display: flex; justify-content: space-between; align-items: center; }
.guide-name { color: #9b7a51; font-size: 20rpx; font-weight: 500; letter-spacing: 2rpx; }
.guide-progress { color: #aa9479; font-family: var(--font-numeral,serif); font-size: 19rpx; }
.guide-title { margin-top: 12rpx; color: #30261d; font-size: 31rpx; font-weight: 500; letter-spacing: 2rpx; }
.guide-message { margin-top: 12rpx; color: #665645; font-size: 23rpx; line-height: 1.7; }
.guide-actions { margin-top: 19rpx; display: flex; align-items: center; justify-content: flex-end; gap: 14rpx; }

.guide-actions button {
  height: 62rpx;
  margin: 0;
  padding: 0 24rpx;
  line-height: 62rpx;
  border-radius: 8rpx;
  font-family: var(--font-display,"Source Han Serif SC","Noto Serif SC",serif);
  font-size: 22rpx;
  font-weight: 500;
}

.guide-actions button::after { border: 0; }
.guide-skip { background: transparent; color: #8c7a65; }
.guide-auto-hint { color: #a17d4e; font-size: 20rpx; letter-spacing: 1rpx; }
.guide-next { min-width: 170rpx; background: linear-gradient(135deg,#ad8651,#8b642f); color: #fffaf0; box-shadow: 0 7rpx 14rpx rgba(99,68,31,.17); }
.guide-next text { margin-left: 8rpx; font-family: var(--font-numeral,serif); font-size: 29rpx; }

.focus-blocker {
  position: fixed;
  z-index: 175;
  background: rgba(36,30,24,.64);
}

.focus-blocker-top { left: 0; right: 0; top: 0; }
.focus-blocker-bottom { left: 0; right: 0; bottom: 0; }
.focus-blocker-left { left: 0; }
.focus-blocker-right { right: 0; }

.focus-ring {
  position: fixed;
  z-index: 177;
  box-sizing: border-box;
  border: 4rpx solid #d7b16f;
  border-radius: 18rpx;
  box-shadow: 0 0 0 2rpx rgba(255,248,225,.72), 0 0 24rpx rgba(238,194,113,.95), inset 0 0 20rpx rgba(255,236,187,.25);
  pointer-events: none;
  animation: guide-focus-pulse 1.25s ease-in-out infinite;
}

.focus-proxy {
  position: fixed;
  z-index: 179;
  background: rgba(255,255,255,.01);
}

.focus-hint {
  position: fixed;
  left: 50%;
  z-index: 181;
  width: 430rpx;
  padding: 17rpx 22rpx;
  box-sizing: border-box;
  transform: translateX(-50%);
  border: 1rpx solid rgba(142,104,59,.34);
  border-radius: 32rpx;
  background: rgba(250,246,238,.96);
  color: #5c4935;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(45,32,20,.22);
  pointer-events: none;
}

@keyframes guide-focus-pulse {
  0%, 100% { transform: scale(1); filter: brightness(1); }
  50% { transform: scale(1.025); filter: brightness(1.12); }
}
