.guide-shell { position: fixed; left: 28rpx; right: 28rpx; z-index: 180; display: flex; align-items: flex-end; gap: 14rpx; pointer-events: none; }.guide-bottom { bottom: calc(128rpx + env(safe-area-inset-bottom)); }.guide-top { top: calc(122rpx + env(safe-area-inset-top)); align-items: flex-start; }.guide-avatar { position: relative; z-index: 2; flex: none; width: 72rpx; height: 72rpx; line-height: 72rpx; text-align: center; border: 2rpx solid rgba(117,83,42,.55); border-radius: 50%; background: linear-gradient(145deg,#d5ba8d,#9c723e); color: #fff8e9; font-family: var(--font-display,"Source Han Serif SC","Noto Serif SC",serif); font-size: 29rpx; font-weight: 500; box-shadow: 0 10rpx 22rpx rgba(61,42,22,.24); pointer-events: auto; }.guide-bubble { position: relative; flex: 1; max-width: 590rpx; padding: 25rpx 27rpx 22rpx; box-sizing: border-box; border: 1rpx solid rgba(124,91,52,.32); border-radius: 20rpx 20rpx 20rpx 6rpx; background: repeating-linear-gradient(0deg,rgba(119,89,54,.018) 0,rgba(119,89,54,.018) 1rpx,transparent 1rpx,transparent 9rpx),rgba(250,246,238,.97); box-shadow: 0 17rpx 40rpx rgba(53,38,23,.22),inset 0 2rpx 0 rgba(255,255,255,.8); pointer-events: auto; }.guide-bubble::before { content: ''; position: absolute; left: -13rpx; bottom: 22rpx; width: 24rpx; height: 24rpx; transform: rotate(45deg); border-left: 1rpx solid rgba(124,91,52,.32); border-bottom: 1rpx solid rgba(124,91,52,.32); background: #f8f3ea; }.guide-top .guide-bubble::before { top: 22rpx; bottom: auto; }.guide-topline { display: flex; justify-content: space-between; align-items: center; }.guide-name { color: #9b7a51; font-size: 20rpx; font-weight: 500; letter-spacing: 2rpx; }.guide-progress { color: #aa9479; font-family: var(--font-numeral,serif); font-size: 19rpx; }.guide-title { margin-top: 12rpx; color: #30261d; font-size: 31rpx; font-weight: 500; letter-spacing: 2rpx; }.guide-message { margin-top: 12rpx; color: #665645; font-size: 23rpx; line-height: 1.7; }.guide-actions { margin-top: 19rpx; display: flex; align-items: center; justify-content: flex-end; gap: 14rpx; }.guide-actions button { height: 62rpx; margin: 0; padding: 0 24rpx; line-height: 62rpx; border-radius: 8rpx; font-family: var(--font-display,"Source Han Serif SC","Noto Serif SC",serif); font-size: 22rpx; font-weight: 500; }.guide-actions button::after { border: 0; }.guide-skip { background: transparent; color: #8c7a65; }.guide-next { min-width: 170rpx; background: linear-gradient(135deg,#ad8651,#8b642f); color: #fffaf0; box-shadow: 0 7rpx 14rpx rgba(99,68,31,.17); }.guide-next text { margin-left: 8rpx; font-family: var(--font-numeral,serif); font-size: 29rpx; }
